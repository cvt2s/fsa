Library:GiveSignal(RunService.RenderStepped:Connect(function(dt)
    if Library.Toggled then
        PvPFOVCircle.Visible = false
        FFAFOVCircle.Visible = false
        ClearHighlights()
        return
    end

    frameCount = frameCount + 1
    if frameCount < 2 then return end
    frameCount = 0

    local center = GetScreenCenter()
    local pvpOn  = Toggles.PvPEnabled and Toggles.PvPEnabled.Value
    local ffaOn  = Toggles.FFAEnabled and Toggles.FFAEnabled.Value

    if pvpOn then
        local fov     = Options.PvPFOV and Options.PvPFOV.Value or 120
        local showFOV = Toggles.PvPShowFOV and Toggles.PvPShowFOV.Value or false
        PvPFOVCircle.Visible  = showFOV
        PvPFOVCircle.Radius   = fov
        PvPFOVCircle.Position = center

        if PassesHitChance(Options.PvPHitChance and Options.PvPHitChance.Value or 100) then
            local target = PvPGetTarget()
            if target then
                local partName = Options.PvPHitPart and Options.PvPHitPart.Value or "Head"
                local part     = GetPartForName(target, partName)
                if part then
                    local useSmooth = Toggles.PvPUseSmoothing and Toggles.PvPUseSmoothing.Value
                    if useSmooth then
                        local smooth = Options.PvPSmoothing and Options.PvPSmoothing.Value or 8
                        Camera.CFrame = Camera.CFrame:Lerp(
                            CFrame.new(Camera.CFrame.Position, part.Position),
                            math.min(dt * smooth, 1)
                        )
                    else
                        Camera.CFrame = CFrame.new(Camera.CFrame.Position, part.Position)
                    end
                end

                if Toggles.PvPHighlight and Toggles.PvPHighlight.Value then
                    SetHighlight(target, true)
                    for char in pairs(ActiveHighlights) do
                        if char ~= target then SetHighlight(char, false) end
                    end
                else
                    ClearHighlights()
                end

                local hbSize = Options.PvPHitboxSize and Options.PvPHitboxSize.Value or 1
                if hbSize > 1 then SetHitbox(hbSize, target) end
            else
                ClearHighlights()
            end
        end

        if Toggles.PvPTriggerbot and Toggles.PvPTriggerbot.Value then
            local mouse   = LP:GetMouse()
            local mTarget = mouse.Target
            if mTarget then
                local tChar = Players:GetPlayerFromCharacter(mTarget.Parent)
                if tChar and tChar ~= LP then
                    local wls      = GetWLStatus(tChar)
                    local skipTeam = Toggles.PvPTeamCheck and Toggles.PvPTeamCheck.Value
                        and LP.Team ~= nil and tChar.Team ~= nil and tChar.Team == LP.Team
                    if wls ~= "friend" and wls ~= "neutral" and not skipTeam then
                        local minD = Options.PvPTriggerMin and Options.PvPTriggerMin.Value or 50
                        local maxD = Options.PvPTriggerMax and Options.PvPTriggerMax.Value or 120
                        task.delay(math.random(minD, maxD) / 1000, function()
                            if Toggles.PvPTriggerbot and Toggles.PvPTriggerbot.Value then
                                mouse1click()
                            end
                        end)
                    end
                end
            end
        end

    else
        PvPFOVCircle.Visible = false
    end

    if ffaOn then
        local showFOV = Toggles.FFAShowFOV and Toggles.FFAShowFOV.Value or false
        local useFOV  = Toggles.FFAUseFOV  and Toggles.FFAUseFOV.Value  or false
        local fov     = Options.FFAFOVSize  and Options.FFAFOVSize.Value  or 500
        FFAFOVCircle.Visible  = showFOV and useFOV
        FFAFOVCircle.Radius   = fov
        FFAFOVCircle.Position = center

        if PassesHitChance(Options.FFAHitChance and Options.FFAHitChance.Value or 100) then
            local target = FFAGetTarget()
            if target then
                local partName = Options.FFAHitPart and Options.FFAHitPart.Value or "HumanoidRootPart"
                local part     = GetPartForName(target, partName)
                if part then
                    local useSmooth = Toggles.FFAUseSmoothing and Toggles.FFAUseSmoothing.Value
                    if useSmooth then
                        local smooth = Options.FFASmoothing and Options.FFASmoothing.Value or 10
                        Camera.CFrame = Camera.CFrame:Lerp(
                            CFrame.new(Camera.CFrame.Position, part.Position),
                            math.min(dt * smooth, 1)
                        )
                    else
                        Camera.CFrame = CFrame.new(Camera.CFrame.Position, part.Position)
                    end
                end

                if Toggles.FFAHighlight and Toggles.FFAHighlight.Value then
                    SetHighlight(target, true)
                    for char in pairs(ActiveHighlights) do
                        if char ~= target then SetHighlight(char, false) end
                    end
                else
                    ClearHighlights()
                end

                local hbSize = Options.FFAHitboxSize and Options.FFAHitboxSize.Value or 1
                if hbSize > 1 then SetHitbox(hbSize, target) end
            else
                ClearHighlights()
            end
        end

        if Toggles.FFATriggerbot and Toggles.FFATriggerbot.Value then
            local mouse   = LP:GetMouse()
            local mTarget = mouse.Target
            if mTarget then
                local tChar = Players:GetPlayerFromCharacter(mTarget.Parent)
                if tChar and tChar ~= LP then
                    local wls = GetWLStatus(tChar)
                    if wls ~= "friend" and wls ~= "neutral" then
                        local minD = Options.FFATriggerMin and Options.FFATriggerMin.Value or 50
                        local maxD = Options.FFATriggerMax and Options.FFATriggerMax.Value or 120
                        task.delay(math.random(minD, maxD) / 1000, function()
                            if Toggles.FFATriggerbot and Toggles.FFATriggerbot.Value then
                                mouse1click()
                            end
                        end)
                    end
                end
            end
        end

    else
        FFAFOVCircle.Visible = false
    end
end))

Library:OnUnload(function()
    ClearHighlights()
    ResetAllHitboxes()
    if PvPFOVCircle.__OBJECT_EXISTS then PvPFOVCircle:Remove() end
    if FFAFOVCircle.__OBJECT_EXISTS then FFAFOVCircle:Remove() end
end)

