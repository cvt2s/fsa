repeat task.wait() until Library and ThemeManager and SaveManager

local Options = Library.Options
local Toggles = Library.Toggles

local RADAR_SIZE    = 180
local RADAR_X       = 50
local RADAR_Y       = 50
local radarDragging = false
local dragOffX      = 0
local dragOffY      = 0

local radarBG = Drawing.new("Circle")
radarBG.Filled=true radarBG.Color=Color3.fromRGB(10,10,14) radarBG.Transparency=0.5 radarBG.NumSides=64 radarBG.Visible=false

local radarBGSq = Drawing.new("Square")
radarBGSq.Filled=true radarBGSq.Color=Color3.fromRGB(10,10,14) radarBGSq.Transparency=0.5 radarBGSq.Visible=false

local radarBorder = Drawing.new("Circle")
radarBorder.Filled=false radarBorder.Color=Color3.fromRGB(80,80,100) radarBorder.Thickness=1.2 radarBorder.NumSides=64 radarBorder.Visible=false

local radarBorderSq = Drawing.new("Square")
radarBorderSq.Filled=false radarBorderSq.Color=Color3.fromRGB(80,80,100) radarBorderSq.Thickness=1.2 radarBorderSq.Visible=false

local crossH = Drawing.new("Line")
crossH.Color=Color3.fromRGB(40,40,55) crossH.Thickness=0.6 crossH.Transparency=0.6 crossH.Visible=false
local crossV = Drawing.new("Line")
crossV.Color=Color3.fromRGB(40,40,55) crossV.Thickness=0.6 crossV.Transparency=0.6 crossV.Visible=false

local modeLabel = Drawing.new("Text")
modeLabel.Size=11 modeLabel.Center=true modeLabel.Outline=true modeLabel.Transparency=0.7
modeLabel.Color=Color3.fromRGB(180,180,200) modeLabel.Visible=false

local selfDot = Drawing.new("Triangle")
selfDot.Filled=true selfDot.Color=Color3.fromRGB(255,255,255) selfDot.Transparency=1 selfDot.Visible=false

local MAX_DOTS = 60
local dots = {}
for i = 1, MAX_DOTS do
    local d = Drawing.new("Circle")
    d.Filled=true d.Radius=4 d.NumSides=16 d.Transparency=1 d.Visible=false
    dots[i] = d
end

local function GetCenter()
    return Vector2.new(RADAR_X + RADAR_SIZE/2, RADAR_Y + RADAR_SIZE/2)
end

local function HasTeams()
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Team ~= nil then return true end
    end
    return false
end

local function GetRotAngle()
    local mode = Options.RadarRotation and Options.RadarRotation.Value or "Camera"
    if mode == "Fixed (North Up)" then return 0 end
    local look = Camera.CFrame.LookVector
    return math.atan2(look.X, look.Z)
end

local function WorldToRadar(worldPos, lpHRP, range, rotAngle, shape)
    local rel  = worldPos - lpHRP.Position
    local flat = Vector2.new(rel.X, rel.Z)
    local dist = flat.Magnitude
    local half = RADAR_SIZE / 2

    local cos = math.cos(rotAngle)
    local sin = math.sin(rotAngle)
    local rx  =  flat.X * cos + flat.Z * sin
    local ry  = -flat.X * sin + flat.Z * cos

    local px, py
    if range <= 0 then
        px = rx / math.max(dist, 0.01) * half * 0.9
        py = ry / math.max(dist, 0.01) * half * 0.9
    else
        px = (rx / range) * half
        py = (ry / range) * half
    end

    if shape == "Square" then
        px = math.clamp(px, -half + 6, half - 6)
        py = math.clamp(py, -half + 6, half - 6)
    else
        local mag = math.sqrt(px*px + py*py)
        if mag > half - 6 then
            px = px / mag * (half - 6)
            py = py / mag * (half - 6)
        end
    end

    local center = GetCenter()
    return Vector2.new(center.X + px, center.Y + py), dist
end

local function DrawSelfArrow(center)
    local mode = Options.RadarRotation and Options.RadarRotation.Value or "Camera"
    local angle = 0
    if mode == "Fixed (North Up)" then
        local look = Camera.CFrame.LookVector
        angle = -math.atan2(look.X, look.Z)
    end
    local size = 7
    local ax = math.sin(angle)
    local ay = -math.cos(angle)
    local px = math.cos(angle)
    local py = math.sin(angle)
    selfDot.PointA = Vector2.new(center.X + ax*size,                   center.Y + ay*size)
    selfDot.PointB = Vector2.new(center.X - ax*size + px*size*0.5,     center.Y - ay*size + py*size*0.5)
    selfDot.PointC = Vector2.new(center.X - ax*size - px*size*0.5,     center.Y - ay*size - py*size*0.5)
    selfDot.Visible = true
end

local function ProximityColor(dist, range)
    local maxDist = range > 0 and range or 200
    local t = math.clamp(1 - (dist / maxDist), 0, 1)
    if t > 0.66 then
        local f = (t - 0.66) / 0.34
        return Color3.new(1, 1 - f, 0)
    elseif t > 0.33 then
        local f = (t - 0.33) / 0.33
        return Color3.new(1, 0.4 + f * 0.3, 0)
    else
        return Color3.fromRGB(255, 60, 60)
    end
end

local function GetDotColor(plr, dist, range, isFFA)
    if isFFA then
        local useHeat = Toggles.RadarHeatMap and Toggles.RadarHeatMap.Value
        if useHeat then return ProximityColor(dist, range) end
        return Color3.fromRGB(255, 60, 60)
    end
    if LP.Team ~= nil and plr.Team == LP.Team then
        return Color3.fromRGB(80, 160, 255)
    elseif plr.Team == nil then
        return Color3.fromRGB(160, 160, 160)
    end
    return Color3.fromRGB(255, 60, 60)
end

local function UpdateGeometry(shape, opacity)
    local center = GetCenter()
    local half   = RADAR_SIZE / 2
    local alpha  = 1 - (opacity / 100)

    if shape == "Circle" then
        radarBG.Position=center radarBG.Radius=half radarBG.Transparency=alpha radarBG.Visible=true
        radarBorder.Position=center radarBorder.Radius=half radarBorder.Visible=true
        radarBGSq.Visible=false radarBorderSq.Visible=false
    else
        radarBGSq.Position=Vector2.new(RADAR_X,RADAR_Y) radarBGSq.Size=Vector2.new(RADAR_SIZE,RADAR_SIZE) radarBGSq.Transparency=alpha radarBGSq.Visible=true
        radarBorderSq.Position=Vector2.new(RADAR_X,RADAR_Y) radarBorderSq.Size=Vector2.new(RADAR_SIZE,RADAR_SIZE) radarBorderSq.Visible=true
        radarBG.Visible=false radarBorder.Visible=false
    end

    crossH.From=Vector2.new(RADAR_X+4,center.Y)          crossH.To=Vector2.new(RADAR_X+RADAR_SIZE-4,center.Y) crossH.Visible=true
    crossV.From=Vector2.new(center.X,RADAR_Y+4)           crossV.To=Vector2.new(center.X,RADAR_Y+RADAR_SIZE-4) crossV.Visible=true

    local isFFA = not HasTeams()
    modeLabel.Text     = isFFA and "FFA" or "TEAMS"
    modeLabel.Color    = isFFA and Color3.fromRGB(255,120,60) or Color3.fromRGB(80,200,120)
    modeLabel.Position = Vector2.new(center.X, RADAR_Y + RADAR_SIZE - 16)
    modeLabel.Visible  = true
end

local frameSkip = 0

RunService.RenderStepped:Connect(function()
    local function hideAll()
        radarBG.Visible=false radarBorder.Visible=false radarBGSq.Visible=false radarBorderSq.Visible=false
        crossH.Visible=false crossV.Visible=false selfDot.Visible=false modeLabel.Visible=false
        for _,d in ipairs(dots) do d.Visible=false end
    end

    if Library.Toggled or not (Toggles.RadarEnabled and Toggles.RadarEnabled.Value) then
        hideAll() return
    end

    frameSkip = frameSkip + 1
    if frameSkip < 2 then return end
    frameSkip = 0

    local shape   = Options.RadarShape    and Options.RadarShape.Value    or "Circle"
    local opacity = Options.RadarOpacity  and Options.RadarOpacity.Value  or 50
    local range   = Options.RadarRange    and Options.RadarRange.Value    or 0
    local show    = Options.RadarShow     and Options.RadarShow.Value     or "Auto"
    RADAR_SIZE    = Options.RadarSize     and Options.RadarSize.Value     or 180

    if radarDragging then
        local mp = UIS:GetMouseLocation()
        RADAR_X  = mp.X - dragOffX
        RADAR_Y  = mp.Y - dragOffY
    end

    UpdateGeometry(shape, opacity)

    local lpChar = LP.Character
    local lpHRP  = lpChar and lpChar:FindFirstChild("HumanoidRootPart")
    local center = GetCenter()
    local rotAng = GetRotAngle()
    local isFFA  = not HasTeams()

    DrawSelfArrow(center)

    local idx = 1
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and idx <= MAX_DOTS then
            local char = plr.Character
            local hrp  = char and char:FindFirstChild("HumanoidRootPart")
            local hum  = char and char:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 and lpHRP then
                local isTeam = LP.Team ~= nil and plr.Team == LP.Team
                local skip = false

                if show == "Auto" then
                    skip = false
                elseif show == "Enemies Only" then
                    skip = isTeam
                elseif show == "Teammates Only" then
                    skip = not isTeam
                end

                if not skip then
                    local sp, dist = WorldToRadar(hrp.Position, lpHRP, range, rotAng, shape)
                    local dot      = dots[idx]
                    dot.Position     = sp
                    dot.Color        = GetDotColor(plr, dist, range, isFFA)
                    dot.Radius       = 4
                    dot.Transparency = 1
                    dot.Visible      = true
                    idx = idx + 1
                end
            end
        end
    end

    for i = idx, MAX_DOTS do dots[i].Visible = false end
end)

UIS.InputBegan:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
    if not (Toggles.RadarEnabled and Toggles.RadarEnabled.Value) then return end
    local mp     = UIS:GetMouseLocation()
    local center = GetCenter()
    local half   = RADAR_SIZE / 2
    local shape  = Options.RadarShape and Options.RadarShape.Value or "Circle"
    local hit    = false
    if shape == "Circle" then
        hit = (mp - center).Magnitude <= half
    else
        hit = mp.X >= RADAR_X and mp.X <= RADAR_X + RADAR_SIZE and mp.Y >= RADAR_Y and mp.Y <= RADAR_Y + RADAR_SIZE
    end
    if hit then radarDragging=true dragOffX=mp.X-RADAR_X dragOffY=mp.Y-RADAR_Y end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then radarDragging = false end
end)

