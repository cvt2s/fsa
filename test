RadLeft:AddSlider("RadarRange",   { Text="Range",   Default=0,   Min=0,   Max=1000, Rounding=0, Suffix=" studs",
    Tooltip="0 = show all players at any distance" })
RadLeft:AddSlider("RadarOpacity", { Text="Opacity", Default=50,  Min=0,   Max=100, Rounding=0, Suffix="%" })

RadRight:AddToggle("RadarHeatMap", { Text="Proximity Heat",  Default=false,
    Tooltip="FFA mode only — dots shift yellow/orange the closer a player is to you" })
RadRight:AddDivider()
RadRight:AddLabel({ Text="Auto mode:\nNo teams → FFA (everyone red/heat)\nTeams detected → enemies red, allies blue, unassigned grey\n\nDrag radar with left click.", DoesWrap=true })
RadRight:AddDivider()
RadRight:AddButton({ Text="Reset Position", Func=function()
    RADAR_X=50 RADAR_Y=50
    Library:Notify({Title="Radar",Description="Position reset.",Time=2})
