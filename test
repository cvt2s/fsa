local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local pvpLockedTarget   = nil
local pvpLockedUUID     = nil
local pvpNotifFired     = false
local ffaLockedTarget   = nil
