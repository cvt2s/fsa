local entityCache       = {}
local entityCacheTime   = 0
local CACHE_TTL         = 0.5
local frameCount        = 0
local HitboxOriginalSizes = {}
local WhitelistData     = {}
local ActiveHighlights  = {}

local function GetWLStatus(plr)
    if not plr then return "enemy" end
    local data = WhitelistData[tostring(plr.UserId)]
    return data and data.status or "enemy"
end

local function CanSee(origin, target, ignore)
    rayParams.FilterDescendantsInstances = ignore
    return workspace:Raycast(origin, target - origin, rayParams) == nil
end

local function SetHitbox(multiplier, char)
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local key = tostring(char)
    if multiplier <= 1 then
        if HitboxOriginalSizes[key] then hrp.Size = HitboxOriginalSizes[key] end
        return
    end
    if not HitboxOriginalSizes[key] then
        HitboxOriginalSizes[key] = hrp.Size
    end
    hrp.Size = HitboxOriginalSizes[key] * multiplier
end

local function ResetAllHitboxes()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character then
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            local key = tostring(plr.Character)
            if hrp and HitboxOriginalSizes[key] then
                hrp.Size = HitboxOriginalSizes[key]
            end
        end
    end
    HitboxOriginalSizes = {}
end

local function ClearHighlights()
    for char, hl in pairs(ActiveHighlights) do
        pcall(function() hl:Destroy() end)
        ActiveHighlights[char] = nil
    end
end

local function SetHighlight(char, active)
    if not char then return end
    if active then
        if ActiveHighlights[char] then return end
        local hl = Instance.new("SelectionBox")
        hl.LineThickness       = 0.05
        hl.Color3              = Color3.fromRGB(255, 80, 80)
        hl.SurfaceColor3       = Color3.fromRGB(255, 80, 80)
        hl.SurfaceTransparency = 0.7
        hl.Adornee             = char
        hl.Parent              = workspace
        ActiveHighlights[char] = hl
    else
        if ActiveHighlights[char] then
            pcall(function() ActiveHighlights[char]:Destroy() end)
            ActiveHighlights[char] = nil
        end
    end
end

local function GetEntities()
    local now = tick()
    if now - entityCacheTime < CACHE_TTL then return entityCache end
    entityCacheTime = now
    local list = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then
            local status = GetWLStatus(plr)
            if status ~= "neutral" then
                local char = plr.Character
                if char then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    local hrp = char:FindFirstChild("HumanoidRootPart")
                    if hum and hum.Health > 0 and hrp then
                        table.insert(list, {
                            char     = char,
                            hum      = hum,
                            hrp      = hrp,
                            player   = plr,
                            isFriend = status == "friend",
                        })
                    end
                end
            end
        end
    end
    entityCache = list
    return list
end

local function GetScreenCenter()
    return Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
end

local function GetPartForName(char, name)
    return char:FindFirstChild(name)
        or char:FindFirstChild("Head")
        or char:FindFirstChild("HumanoidRootPart")
end

local function PassesHitChance(pct)
    return math.random(1, 100) <= pct
end

local function Notify(title, body, duration)
    Library:Notify({
        Title       = title,
        Description = body,
        Time        = duration or 5,
    })
end

local function PvPGetTarget()
    local lpChar = LP.Character
    local lpHRP  = lpChar and lpChar:FindFirstChild("HumanoidRootPart")
    if not lpHRP then return nil end

    local useTeam  = Toggles.PvPTeamCheck and Toggles.PvPTeamCheck.Value
    local useVis   = Toggles.PvPVisCheck   and Toggles.PvPVisCheck.Value
    local fov      = Options.PvPFOV        and Options.PvPFOV.Value        or 120
    local partName = Options.PvPHitPart    and Options.PvPHitPart.Value    or "Head"
    local priority = Options.PvPPriority   and Options.PvPPriority.Value   or "Closest to Crosshair"
    local center   = GetScreenCenter()

    if pvpLockedTarget then
        local hum = pvpLockedTarget:FindFirstChildOfClass("Humanoid")
        local hrp = pvpLockedTarget:FindFirstChild("HumanoidRootPart")
        if hum and hum.Health > 0 and hrp and pvpLockedTarget.Parent then
            return pvpLockedTarget
        else
            pvpLockedTarget = nil
            pvpLockedUUID   = nil
            pvpNotifFired   = false
            Notify("PvP", "Lock broken — target eliminated or left.", 5)
        end
    end

    local bestScore = math.huge
    local bestChar  = nil
    local bestPlr   = nil

    for _, data in ipairs(GetEntities()) do
        if not data.isFriend then
            local skipTeam = useTeam
                and LP.Team ~= nil
                and data.player.Team ~= nil
                and data.player.Team == LP.Team
            if not skipTeam then
                local part = GetPartForName(data.char, partName)
                if part then
                    local sp, on = Camera:WorldToViewportPoint(part.Position)
                    if on then
                        local screenDist = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                        if screenDist <= fov then
                            local canHit = true
                            if useVis then
                                canHit = CanSee(Camera.CFrame.Position, part.Position, { lpChar, data.char })
                            end
                            if canHit then
                                local score
                                if priority == "Lowest HP" then
                                    score = data.hum.Health
                                elseif priority == "Closest Distance" then
                                    score = (lpHRP.Position - data.hrp.Position).Magnitude
                                else
                                    score = screenDist
                                end
                                if score < bestScore then
                                    bestScore = score
                                    bestChar  = data.char
                                    bestPlr   = data.player
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    if bestChar and bestPlr then
        local newUUID = tostring(bestPlr.UserId)
        if newUUID ~= pvpLockedUUID then
            pvpLockedTarget = bestChar
            pvpLockedUUID   = newUUID
            pvpNotifFired   = false
        end
        if not pvpNotifFired then
            pvpNotifFired = true
            Notify(
                "PvP — Target Acquired",
                "Locked onto: " .. bestPlr.Name .. "\nUUID: " .. newUUID .. "\nBreak manually to switch targets.",
                8
            )
        end
    end

    return bestChar
end

local function FFAGetTarget()
    local lpChar = LP.Character
    local lpHRP  = lpChar and lpChar:FindFirstChild("HumanoidRootPart")
    if not lpHRP then return nil end

    local useVis   = Toggles.FFAVisCheck  and Toggles.FFAVisCheck.Value  or false
    local useDynHP = Toggles.FFADynHP     and Toggles.FFADynHP.Value     or false
    local useUUID  = Toggles.FFAUUIDLock  and Toggles.FFAUUIDLock.Value  or false
    local partName = Options.FFAHitPart   and Options.FFAHitPart.Value   or "HumanoidRootPart"
    local fov      = Options.FFAFOVSize   and Options.FFAFOVSize.Value   or 500
    local useFOV   = Toggles.FFAUseFOV   and Toggles.FFAUseFOV.Value    or false
    local center   = GetScreenCenter()

    if ffaLockedTarget then
        local hum = ffaLockedTarget:FindFirstChildOfClass("Humanoid")
        local hrp = ffaLockedTarget:FindFirstChild("HumanoidRootPart")
        if hum and hum.Health > 0 and hrp and ffaLockedTarget.Parent then
            return ffaLockedTarget
        else
            ffaLockedTarget = nil
            ffaLockedUUID   = nil
            ffaNotifFired   = false
            Notify("FFA", "Lock broken — target eliminated or left.", 5)
        end
    end

    local bestScore = math.huge
    local bestChar  = nil
    local bestPlr   = nil

    for _, data in ipairs(GetEntities()) do
        if not data.isFriend then
            local part = GetPartForName(data.char, partName)
            if part then
                local inFOV = true
                if useFOV then
                    local sp, on = Camera:WorldToViewportPoint(part.Position)
                    if not on or (Vector2.new(sp.X, sp.Y) - center).Magnitude > fov then
                        inFOV = false
                    end
                end
                if inFOV then
                    local canHit = true
                    if useVis then
                        canHit = CanSee(Camera.CFrame.Position, part.Position, { lpChar, data.char })
                    end
                    if canHit then
                        local score = useDynHP
                            and data.hum.Health
                            or  (lpHRP.Position - data.hrp.Position).Magnitude
                        if score < bestScore then
                            bestScore = score
                            bestChar  = data.char
                            bestPlr   = data.player
                        end
                    end
                end
            end
        end
    end

    if bestChar and bestPlr then
        local newUUID = tostring(bestPlr.UserId)
        if newUUID ~= ffaLockedUUID then
            ffaLockedTarget = bestChar
            ffaLockedUUID   = newUUID
            ffaNotifFired   = false
        end
        if not ffaNotifFired then
            ffaNotifFired = true
            local lockType = useUUID and "UUID Lock" or "Proximity Lock"
            Notify(
                "FFA — Target Acquired",
                "Locked onto: " .. bestPlr.Name .. "\nUUID: " .. newUUID .. "\nMode: " .. lockType .. "\nBreak manually to switch targets.",
                8
            )
        end
    end

    return bestChar
end

