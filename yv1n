Options.JumpPower:OnChanged(function(value)
    local hum = GetHum()
    if hum then hum.JumpPower = value end
end)

Options.CameraFOV:OnChanged(function(value)
    workspace.CurrentCamera.FieldOfView = value
end)

Options.HitboxMultiplier:OnChanged(function(value)
    SetHitbox(value)
end)

Toggles.FlyEnabled:OnChanged(function(state)
    if state then StartFly() else StopFly() end
end)

Toggles.NoclipEnabled:OnChanged(function(state)
    if state then StartNoclip() else StopNoclip() end
end)

Toggles.NoclipFloat:OnChanged(function()
    if Toggles.NoclipEnabled and Toggles.NoclipEnabled.Value then
        StopNoclip()
        StartNoclip()
    end
end)

Toggles.InfiniteJump:OnChanged(function()
    Library:GiveSignal(UIS.JumpRequest:Connect(function()
        if not Toggles.InfiniteJump.Value then return end
        local hum = GetHum()
        if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
    end))
end)

Toggles.AntiAFK:OnChanged(function(state)
    if state then
        task.spawn(function()
            local vu = game:GetService("VirtualUser")
            while Toggles.AntiAFK.Value do
                vu:Button2Down(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
                task.wait(0.1)
                vu:Button2Up(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
                task.wait(15)
            end
        end)
    end
end)

Toggles.ChatSpyEnabled:OnChanged(function(state)
    if state then
        HookChat()
        Library:Notify({ Title = "Chat Spy", Description = "Active.", Time = 2 })
    end
end)

Toggles.FullbrightEnabled:OnChanged(function(state)
    if state then
        Lighting.Ambient = Color3.fromRGB(255,255,255) Lighting.OutdoorAmbient = Color3.fromRGB(255,255,255)
        Lighting.Brightness = 2 Lighting.GlobalShadows = false Lighting.FogEnd = 1e9
    else
        Lighting.Ambient = DefaultAmbient Lighting.OutdoorAmbient = DefaultOutdoor
        Lighting.Brightness = DefaultBrightness Lighting.GlobalShadows = DefaultShadows Lighting.FogEnd = DefaultFogEnd
    end
end)

Toggles.RemoveFog:OnChanged(function(state)
    Lighting.FogEnd = state and 1e9 or DefaultFogEnd
end)

Toggles.SkyboxEnabled:OnChanged(function(state)
    if not state then return end
    local preset  = Options.SkyboxPreset.Value
    local sky     = Lighting:FindFirstChildOfClass("Sky") or Instance.new("Sky", Lighting)
    local presets = {
        Night  = { SkyboxBk="rbxassetid://159454286",SkyboxDn="rbxassetid://159454260",SkyboxFt="rbxassetid://159454269",SkyboxLf="rbxassetid://159454293",SkyboxRt="rbxassetid://159454296",SkyboxUp="rbxassetid://159454302" },
        Sunset = { SkyboxBk="rbxassetid://159454875",SkyboxDn="rbxassetid://159454893",SkyboxFt="rbxassetid://159454882",SkyboxLf="rbxassetid://159454899",SkyboxRt="rbxassetid://159454906",SkyboxUp="rbxassetid://159454912" },
        Space  = { SkyboxBk="rbxassetid://159455023",SkyboxDn="rbxassetid://159455041",SkyboxFt="rbxassetid://159455031",SkyboxLf="rbxassetid://159455048",SkyboxRt="rbxassetid://159455055",SkyboxUp="rbxassetid://159455062" },
    }
    if presets[preset] then for prop, val in pairs(presets[preset]) do sky[prop] = val end end
end)

local BotAimbotTabAdded = false
local BotESPTabAdded    = false

Toggles.EnableBotFeatures:OnChanged(function(state)
    BotFeaturesEnabled = state
    if state then
        if not BotAimbotTabAdded then
            BotAimbotTabAdded = true
            local BotAimTab = AimbotTabbox:AddTab("Bot")
            BotAimTab:AddToggle("BotAimbotEnabled", { Text = "Enable Bot Aimbot", Default = false })
            BotAimTab:AddDropdown("BotAimPart", { Text = "Target Part", Values = { "HumanoidRootPart","Head","UpperTorso" }, Default = 1 })
            BotAimTab:AddSlider("BotAimFOV",      { Text = "FOV",       Default = 180, Min=10, Max=500, Rounding=0, Suffix="px" })
            BotAimTab:AddSlider("BotAimSmoothing",{ Text = "Smoothing", Default = 5,   Min=1,  Max=100, Rounding=1 })
        end
        if not BotESPTabAdded then
            BotESPTabAdded = true
            local BotESPTab = ESPTabbox:AddTab("Bot")
            BotESPTab:AddToggle("BotESPEnabled",     { Text = "Enable Bot ESP",  Default = false })
            BotESPTab:AddToggle("BotESPBox",         { Text = "Box ESP",         Default = false })
            BotESPTab:AddToggle("BotESPName",        { Text = "Name ESP",        Default = false })
            BotESPTab:AddToggle("BotESPHealth",      { Text = "Health Bar",      Default = false })
            BotESPTab:AddToggle("BotESPNumerical",   { Text = "Show HP Number",  Default = false })
            BotESPTab:AddSlider("BotESPMaxDistance", { Text = "Max Distance",    Default = 500, Min=50, Max=3000, Rounding=0, Suffix=" studs" })
        end
        Library:Notify({ Title = "Bot Features", Description = "Bot tabs added.", Time = 3 })
    end
end)

task.spawn(function()
    task.wait(3)
    local candidates = ScanForNpcFolder()
    if #candidates > 0 then
        local Dialog
        Dialog = Window:AddDialog("npc_folder_detect", {
            Title       = "NPC Folder Detected",
            Description = 'Found "' .. candidates[1].Name .. '" — use it for bot targeting?',
            AutoDismiss = false,
            OutsideClickDismiss = false,
            FooterButtons = {
                Skip = { Title="Scan All", Variant="Ghost", Order=1, Callback=function() NpcFolder=nil end },
                Use  = { Title="Use It",   Variant="Primary",Order=2, Callback=function()
                    NpcFolder = candidates[1]
                    Library:Notify({ Title="Bot", Description="Using: "..NpcFolder.Name, Time=3 })
                end },
            },
        })
    end
end)

