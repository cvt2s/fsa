local function GetModelBounds(char)
    local minX, minY, minZ =  math.huge,  math.huge,  math.huge
    local maxX, maxY, maxZ = -math.huge, -math.huge, -math.huge
    local found = false
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
            local pos  = part.Position
            local half = part.Size / 2
            minX = math.min(minX, pos.X - half.X)
            minY = math.min(minY, pos.Y - half.Y)
            minZ = math.min(minZ, pos.Z - half.Z)
            maxX = math.max(maxX, pos.X + half.X)
            maxY = math.max(maxY, pos.Y + half.Y)
            maxZ = math.max(maxZ, pos.Z + half.Z)
            found = true
        end
    end
    if not found then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            return hrp.Position + Vector3.new(0, 2.5, 0), hrp.Position - Vector3.new(0, 3, 0), hrp.Position
        end
        return Vector3.zero, Vector3.zero, Vector3.zero
    end
    local center = Vector3.new((minX+maxX)/2, (minY+maxY)/2, (minZ+maxZ)/2)
    return Vector3.new(center.X, maxY, center.Z),
           Vector3.new(center.X, minY, center.Z),
           center
end

local function HPColor(pct)
