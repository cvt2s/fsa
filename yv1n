local function GetRigType(char)
    if char:FindFirstChild("UpperTorso") then return "R15" end
    if char:FindFirstChild("Torso")      then return "R6"  end
    return "R15"
end

local function GetJoints(char)
    return GetRigType(char) == "R6" and JOINTS_R6 or JOINTS_R15
end

local function GetCharBounds(char, hum, hrp)
    local head = char:FindFirstChild("Head")
    local topPos, botPos
    if GetRigType(char) == "R6" then
        topPos = head and (head.Position + Vector3.new(0, head.Size.Y / 2, 0)) or (hrp.Position + Vector3.new(0, 2.5, 0))
        botPos = hrp.Position - Vector3.new(0, hum.HipHeight, 0)
    else
        local lf = char:FindFirstChild("LeftFoot")
        local rf = char:FindFirstChild("RightFoot")
        topPos = head and (head.Position + Vector3.new(0, head.Size.Y / 2, 0)) or (hrp.Position + Vector3.new(0, 2.5, 0))
        if lf and rf then
            local footY = math.min(lf.Position.Y - lf.Size.Y / 2, rf.Position.Y - rf.Size.Y / 2)
            botPos = Vector3.new(hrp.Position.X, footY, hrp.Position.Z)
        else
            botPos = hrp.Position - Vector3.new(0, hum.HipHeight, 0)
        end
    end
    return topPos, botPos
end

