local function StopFly()
    if FlyConnection then FlyConnection:Disconnect() FlyConnection = nil end
    if FlyBodyVel    then FlyBodyVel:Destroy()       FlyBodyVel    = nil end
    if FlyBodyGyro   then FlyBodyGyro:Destroy()      FlyBodyGyro   = nil end
    local hrp = GetHRP()
    if hrp then hrp.AssemblyLinearVelocity = Vector3.zero end
end

local function StartFly()
    StopFly()
    local hrp = GetHRP()
    if not hrp then return end
    FlyBodyVel            = Instance.new("BodyVelocity")
    FlyBodyVel.Velocity   = Vector3.zero
    FlyBodyVel.MaxForce   = Vector3.new(1e9, 1e9, 1e9)
    FlyBodyVel.P          = 1e4
    FlyBodyVel.Parent     = hrp
    FlyBodyGyro           = Instance.new("BodyGyro")
    FlyBodyGyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    FlyBodyGyro.P         = 1e4
    FlyBodyGyro.D         = 100
    FlyBodyGyro.CFrame    = hrp.CFrame
    FlyBodyGyro.Parent    = hrp
    local currentVel = Vector3.zero
    FlyConnection = RunService.RenderStepped:Connect(function(dt)
        if not Toggles.FlyEnabled.Value then StopFly() return end
        local speed   = Options.FlySpeed.Value
        local cam     = workspace.CurrentCamera
        local moveDir = Vector3.zero
        if UIS:IsKeyDown(Enum.KeyCode.W)         then moveDir = moveDir + cam.CFrame.LookVector  end
        if UIS:IsKeyDown(Enum.KeyCode.S)         then moveDir = moveDir - cam.CFrame.LookVector  end
        if UIS:IsKeyDown(Enum.KeyCode.A)         then moveDir = moveDir - cam.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.D)         then moveDir = moveDir + cam.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.Space)     then moveDir = moveDir + Vector3.new(0, 1, 0)   end
        if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then moveDir = moveDir - Vector3.new(0, 1, 0)   end
        local targetVel = moveDir.Magnitude > 0 and moveDir.Unit * speed or Vector3.zero
        currentVel = currentVel:Lerp(targetVel, math.min(dt * 12, 1))
        FlyBodyVel.Velocity = currentVel
        FlyBodyGyro.CFrame  = cam.CFrame
    end)
end

local function StopNoclip()
    if NoclipConnection then NoclipConnection:Disconnect() NoclipConnection = nil end
    if FloatConnection  then FloatConnection:Disconnect()  FloatConnection  = nil end
    if FloatBody        then FloatBody:Destroy()           FloatBody        = nil end
    local char = LP.Character
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then part.CanCollide = true end
    end
end

local function StartNoclip()
    StopNoclip()
    local floatMode = Toggles.NoclipFloat and Toggles.NoclipFloat.Value
    local hrp       = GetHRP()

    if floatMode and hrp then
        local targetY = hrp.Position.Y
        FloatBody = Instance.new("BodyPosition")
        FloatBody.Position  = Vector3.new(hrp.Position.X, targetY, hrp.Position.Z)
        FloatBody.MaxForce  = Vector3.new(0, 1e9, 0)
        FloatBody.P         = 5000
        FloatBody.D         = 500
        FloatBody.Parent    = hrp
    end

    NoclipConnection = RunService.Stepped:Connect(function()
        if not Toggles.NoclipEnabled.Value then StopNoclip() return end
        local char = LP.Character
        if not char then return end
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
        if floatMode and FloatBody and hrp then
            local hrpNow = GetHRP()
            if hrpNow then
                FloatBody.Position = Vector3.new(hrpNow.Position.X, targetY, hrpNow.Position.Z)
            end
        end
    end)
end

local function DoWalkfling()
    if WalkflingCooldown then return end
    local hum = GetHum()
    if not hum then return end
    WalkflingCooldown = true
    local original = hum.WalkSpeed
    hum.WalkSpeed = Options.WalkflingSpeed.Value
    task.wait(Options.WalkflingDuration.Value / 1000)
    hum.WalkSpeed = original
    task.wait(0.3)
    WalkflingCooldown = false
end

local function SetHitbox(multiplier)
    local char = LP.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    if multiplier <= 1 then
        local orig = HitboxOriginalSizes[tostring(LP.UserId)]
        if orig then hrp.Size = orig end
        return
    end
    if not HitboxOriginalSizes[tostring(LP.UserId)] then
        HitboxOriginalSizes[tostring(LP.UserId)] = hrp.Size
    end
    hrp.Size = HitboxOriginalSizes[tostring(LP.UserId)] * multiplier
end

local function HookChat()
    if ChatHooked then return end
    ChatHooked = true
    pcall(function()
        if TextChatService.ChatVersion == Enum.ChatVersion.LegacyChatService then
            for _, plr in ipairs(Players:GetPlayers()) do
                plr.Chatted:Connect(function(msg)
                    if Toggles.ChatSpyEnabled and Toggles.ChatSpyEnabled.Value then
                        table.insert(ChatMessages, "[" .. plr.Name .. "]: " .. msg)
                        if #ChatMessages > 50 then table.remove(ChatMessages, 1) end
                    end
                end)
            end
            Players.PlayerAdded:Connect(function(plr)
                plr.Chatted:Connect(function(msg)
                    if Toggles.ChatSpyEnabled and Toggles.ChatSpyEnabled.Value then
                        table.insert(ChatMessages, "[" .. plr.Name .. "]: " .. msg)
                        if #ChatMessages > 50 then table.remove(ChatMessages, 1) end
                    end
                end)
            end)
        else
            TextChatService.MessageReceived:Connect(function(msg)
                if Toggles.ChatSpyEnabled and Toggles.ChatSpyEnabled.Value then
                    local speaker = msg.TextSource and msg.TextSource.Name or "?"
                    table.insert(ChatMessages, "[" .. speaker .. "]: " .. msg.Text)
                    if #ChatMessages > 50 then table.remove(ChatMessages, 1) end
                end
            end)
        end
    end)
end

local function ScanForNpcFolder()
    local candidates = {}
    local playerChars = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character then playerChars[plr.Character] = true end
    end
    for _, child in ipairs(workspace:GetChildren()) do
        if child:IsA("Folder") or child:IsA("Model") then
            for _, desc in ipairs(child:GetDescendants()) do
                if desc:IsA("Humanoid") and not playerChars[desc.Parent] then
                    table.insert(candidates, child)
                    break
                end
            end
        end
    end
    return candidates
end

