local function IsPlayerModel(model)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character == model then return true end
    end
    return false
end

local function ScanForNpcFolder()
    local candidates = {}
    for _, child in ipairs(workspace:GetChildren()) do
        if child:IsA("Folder") or child:IsA("Model") then
            for _, desc in ipairs(child:GetDescendants()) do
                if desc:IsA("Humanoid") and not IsPlayerModel(desc.Parent) then
                    table.insert(candidates, child)
                    break
                end
            end
        end
    end
    return candidates
end

local function GetNpcs()
    local npcs       = {}
    local source     = NpcFolder and {NpcFolder} or workspace:GetChildren()
    local playerChars = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character then playerChars[plr.Character] = true end
    end
    for _, obj in ipairs(source) do
        if not playerChars[obj] then
            local hum = obj:FindFirstChildOfClass("Humanoid")
            if hum and hum.MaxHealth > 0 and hum.Health > 0 then
                local hrp = obj:FindFirstChild("HumanoidRootPart")
                if hrp then table.insert(npcs, { model = obj, hum = hum, hrp = hrp }) end
            end
        end
    end
    return npcs
end

local function HPColor(pct)
    pct = math.clamp(pct, 0, 1)
    if pct > 0.5 then return Color3.new(1 - (pct - 0.5) * 2, 1, 0)
    else return Color3.new(1, pct * 2, 0) end
end

local function _UNUSED_HPColor(pct)
    if pct > 0.5 then
        local t = (pct - 0.5) * 2
        return Color3.new(1 - t, 1, 0)
    else
        local t = pct * 2
        return Color3.new(1, t, 0)
    end
end

local function CleanupESP(entity)
    if espObjects[entity] then
        for _, d in pairs(espObjects[entity]) do
            if d and d.Remove then d:Remove() end
        end
        espObjects[entity] = nil
    end
end

local function GetEntityCache()
    local now = tick()
    if now - entityCacheTime < CACHE_TTL then return entityCache end
    entityCacheTime = now
    local cache = {}
    local lpChar = LP.Character

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and plr.Character then
            local char = plr.Character
            local hum  = char:FindFirstChildOfClass("Humanoid")
            local hrp  = char:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health > 0 and hrp then
                table.insert(cache, {
                    char    = char,
                    hum     = hum,
                    hrp     = hrp,
                    player  = plr,
                    isBot   = false,
                })
            end
        end
    end

    if BotFeaturesEnabled and Toggles.BotESPEnabled and Toggles.BotESPEnabled.Value then
        for _, npc in ipairs(GetNpcs()) do
            table.insert(cache, {
                char   = npc.model,
                hum    = npc.hum,
                hrp    = npc.hrp,
                player = nil,
                isBot  = true,
            })
        end
    end

    entityCache = cache
    return cache
end

local function IsVisible(targetPos, targetChar)
    local lpChar = LP.Character
    if not lpChar or not lpChar:FindFirstChild("Head") then return false end
    local origin    = Camera.CFrame.Position
    local direction = (targetPos - origin)
    local ray       = Ray.new(origin, direction)
    local ignore    = { lpChar, targetChar, Camera }
    local hit       = workspace:FindPartOnRayWithIgnoreList(ray, ignore)
    return hit == nil
end

local function GetSilentTarget()
    local now = tick()
    if now - SilentAimCacheTime < 0.016 then return SilentAimTargetCache end
    SilentAimCacheTime = now

    local fov      = Options.SilentAimFOV and Options.SilentAimFOV.Value or 150
    local partName = Options.SilentAimPart and Options.SilentAimPart.Value or "Head"
    local bestDist = fov
    local closest  = nil
    local center   = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then
            local skip = Toggles.SilentAimTeamCheck and Toggles.SilentAimTeamCheck.Value and plr.Team == LP.Team
            if not skip then
                local char = plr.Character
                if char then
                    local part = char:FindFirstChild(partName) or char:FindFirstChild("HumanoidRootPart")
                    local hum  = char:FindFirstChildOfClass("Humanoid")
                    if part and hum and hum.Health > 0 then
                        local sp, onScreen = Camera:WorldToViewportPoint(part.Position)
                        if onScreen then
                            local dist = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                            if dist < bestDist then
                                bestDist = dist
                                closest  = part
                            end
                        end
                    end
                end
            end
        end
    end

    SilentAimTargetCache = closest
    return closest
end

local function EnableSilentAim()
    if SilentAimHook then return end
    if not hookmetamethod then
        Library:Notify({ Title = "Silent Aim", Description = "hookmetamethod unavailable.", Time = 4 })
        return
    end

    local playerMouse = LP:GetMouse()

    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(...)
        local args   = { ... }
        local self   = args[1]
        local method = getnamecallmethod()
        if Toggles.SilentAimEnabled and Toggles.SilentAimEnabled.Value and self == workspace then
            local target = GetSilentTarget()
            if target then
                if method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRay" then
                    local ray = args[2]
                    if typeof(ray) == "Ray" then
                        args[2] = Ray.new(ray.Origin, (target.Position - ray.Origin).Unit * ray.Direction.Magnitude)
                        return oldNamecall(unpack(args))
                    end
                elseif method == "FindPartOnRayWithWhitelist" then
                    local ray = args[2]
                    if typeof(ray) == "Ray" then
                        args[2] = Ray.new(ray.Origin, (target.Position - ray.Origin).Unit * ray.Direction.Magnitude)
                        return oldNamecall(unpack(args))
                    end
                elseif method == "Raycast" then
                    if typeof(args[2]) == "Vector3" and typeof(args[3]) == "Vector3" then
                        args[3] = (target.Position - args[2]).Unit * args[3].Magnitude
                        return oldNamecall(unpack(args))
                    end
                end
            end
        end
        return oldNamecall(unpack(args))
    end)
    SilentAimHook = oldNamecall

    local oldIndex
    oldIndex = hookmetamethod(game, "__index", function(t, k)
        if Toggles.SilentAimEnabled and Toggles.SilentAimEnabled.Value and t == playerMouse then
            local target = GetSilentTarget()
            if target then
                if k == "Target" then return target end
                if k == "Hit"    then return CFrame.new(target.Position) end
            end
        end
        return oldIndex(t, k)
    end)
    SilentAimIndexHook = oldIndex
end

