local function GetEntities()
    local now = tick()
    if now - entityCacheTime < CACHE_TTL then return entityCache end
    entityCacheTime = now
    local list = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then
            local status = GetWLStatus(plr)
            if status ~= "neutral" then
                local char = plr.Character
                if char then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    local hrp = char:FindFirstChild("HumanoidRootPart")
                    if hum and hum.Health > 0 and hrp then
                        local isFriend   = status == "friend"
                        local isPriority = GetWLPriority(plr)
                        if isPriority then
                            table.insert(list, 1, { char = char, hum = hum, hrp = hrp, player = plr, isFriend = isFriend, isPriority = true })
                        else
                            table.insert(list, { char = char, hum = hum, hrp = hrp, player = plr, isFriend = isFriend, isPriority = false })
                        end
                    end
                end
            end
        end
    end
    if BotFeaturesEnabled and Toggles.BotESPEnabled and Toggles.BotESPEnabled.Value then
        local source = NpcFolder and {NpcFolder} or workspace:GetChildren()
        local playerChars = {}
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr.Character then playerChars[plr.Character] = true end
        end
        for _, obj in ipairs(source) do
            if not playerChars[obj] then
                local hum = obj:FindFirstChildOfClass("Humanoid")
                if hum and hum.MaxHealth > 0 and hum.Health > 0 then
                    local hrp = obj:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        table.insert(list, { char = obj, hum = hum, hrp = hrp, player = nil, isFriend = false, isPriority = false, isBot = true })
                    end
                end
            end
        end
    end
    entityCache = list
    return list
end

local function GetAimbotTarget()
    local lpChar = LP.Character
    local lpHRP  = lpChar and lpChar:FindFirstChild("HumanoidRootPart")
    if not lpHRP then return nil end

    local useRage       = Toggles.AimbotRage and Toggles.AimbotRage.Value
    local useTeamCheck  = Toggles.AimbotTeamCheck and Toggles.AimbotTeamCheck.Value
    local useVisCheck   = Toggles.AimbotVisibleCheck and Toggles.AimbotVisibleCheck.Value
    local fov           = Options.AimbotFOV and Options.AimbotFOV.Value or 120
    local targetPartName= Options.AimbotTargetPart and Options.AimbotTargetPart.Value or "Head"
    local center        = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    if not useRage and stickyTarget then
        local hum = stickyTarget:FindFirstChildOfClass("Humanoid")
        local hrp = stickyTarget:FindFirstChild("HumanoidRootPart")
        if hum and hum.Health > 0 and hrp and stickyTarget.Parent then
            local sp, on = Camera:WorldToViewportPoint(hrp.Position)
            if on and (Vector2.new(sp.X, sp.Y) - center).Magnitude <= fov then
                return stickyTarget
            end
        end
        stickyTarget = nil
    end

    local bestDist    = fov
    local bestChar    = nil
    local foundPriority = false

    for _, data in ipairs(GetEntities()) do
        if not data.isBot and not data.isFriend then
            local skip = false
            if useTeamCheck and LP.Team ~= nil and data.player.Team == LP.Team then skip = true end
            if not skip then
                local part = data.char:FindFirstChild(targetPartName)
                    or data.char:FindFirstChild("Head")
                    or data.hrp
                if part then
                    local sp, on = Camera:WorldToViewportPoint(part.Position)
                    if on then
                        local dist = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                        local distOk = dist < bestDist or (data.isPriority and not foundPriority)
                        if distOk then

        local canHit = true
        if useVisCheck then
            canHit = CanSee(Camera.CFrame.Position, part.Position, { lpChar, data.char })
        end

        if canHit then
            if data.isPriority and not foundPriority then
                foundPriority = true
                bestDist = dist
                bestChar = data.char
            elseif not foundPriority then
                bestDist = dist
                bestChar = data.char
            end
        end
    end

    if bestChar then stickyTarget = bestChar end
    return bestChar
end

local function GetSilentTarget()
    local now = tick()
    if now - SilentAimCacheTime < 0.016 then return SilentAimCache end
    SilentAimCacheTime = now

    local lpChar     = LP.Character
    local fov        = Options.SilentAimFOV and Options.SilentAimFOV.Value or 150
    local partName   = Options.SilentAimPart and Options.SilentAimPart.Value or "Head"
    local useTeam    = Toggles.SilentAimTeamCheck and Toggles.SilentAimTeamCheck.Value
    local center     = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local bestDist   = fov
    local closest    = nil

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then
            local wlStatus = GetWLStatus(plr)
            if wlStatus ~= "neutral" and wlStatus ~= "friend" then
                local skipTeam = useTeam and LP.Team ~= nil and plr.Team == LP.Team
                if not skipTeam then
                    local char = plr.Character
            if char then
                local part = char:FindFirstChild(partName) or char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
                local hum  = char:FindFirstChildOfClass("Humanoid")
                if part and hum and hum.Health > 0 then
                    local sp, on = Camera:WorldToViewportPoint(part.Position)
                    if on then
                        local dist = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                        if dist < bestDist then
                            bestDist = dist
                            closest  = part
                        end
                    end
                end
            end
        end
    end

    SilentAimCache = closest
    return closest
end

local function EnableSilentAim()
    if SilentAimHook then return end
    if not hookmetamethod then
        Library:Notify({ Title = "Silent Aim", Description = "hookmetamethod unavailable.", Time = 4 })
        return
    end

    local playerMouse = LP:GetMouse()

    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(...)
        local args   = { ... }
        local self   = args[1]
        local method = getnamecallmethod()
        if Toggles.SilentAimEnabled and Toggles.SilentAimEnabled.Value and self == workspace then
            local target = GetSilentTarget()
            if target then
                if method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRay" then
                    local ray = args[2]
                    if typeof(ray) == "Ray" then
                        args[2] = Ray.new(ray.Origin, (target.Position - ray.Origin).Unit * ray.Direction.Magnitude)
                        return oldNamecall(unpack(args))
                    end
                elseif method == "FindPartOnRayWithWhitelist" then
                    local ray = args[2]
                    if typeof(ray) == "Ray" then
                        args[2] = Ray.new(ray.Origin, (target.Position - ray.Origin).Unit * ray.Direction.Magnitude)
                        return oldNamecall(unpack(args))
                    end
                elseif method == "Raycast" then
                    if typeof(args[2]) == "Vector3" and typeof(args[3]) == "Vector3" then
                        args[3] = (target.Position - args[2]).Unit * args[3].Magnitude
                        return oldNamecall(unpack(args))
                    end
                end
            end
        end
        return oldNamecall(unpack(args))
    end)
    SilentAimHook = oldNamecall

    local oldIndex
    oldIndex = hookmetamethod(game, "__index", function(t, k)
        if Toggles.SilentAimEnabled and Toggles.SilentAimEnabled.Value and t == playerMouse then
            local target = GetSilentTarget()
            if target then
                if k == "Target" then return target end
                if k == "Hit"    then return CFrame.new(target.Position) end
            end
        end
        return oldIndex(t, k)
    end)
    SilentAimIndexHook = oldIndex
end

