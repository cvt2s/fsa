                end,
            },
        },
    })
end

local function UpdateRiskyCount(delta)
    RiskyActiveCount = math.max(0, RiskyActiveCount + delta)
    if RiskyCountLabel and RiskyCountLabel.SetText then
        if RiskyActiveCount > 0 then
            RiskyCountLabel:SetText("⚠ " .. RiskyActiveCount .. " risky " .. (RiskyActiveCount == 1 and "feature" or "features") .. " active")
            RiskyCountLabel:SetVisible(true)
        else
            RiskyCountLabel:SetVisible(false)
        end
    end
end

local function GlobalKill(state)
    GlobalKillActive = state
    if state then
        if Toggles.AimbotEnabled     then Toggles.AimbotEnabled:SetValue(false)     end
        if Toggles.SilentAimEnabled  then Toggles.SilentAimEnabled:SetValue(false)  end
        if Toggles.ESPEnabled        then Toggles.ESPEnabled:SetValue(false)         end
        if Toggles.TriggerbotEnabled then Toggles.TriggerbotEnabled:SetValue(false)  end
        if Toggles.FlyEnabled        then Toggles.FlyEnabled:SetValue(false)         end
        if Toggles.NoclipEnabled     then Toggles.NoclipEnabled:SetValue(false)      end
        if Toggles.WalkflingEnabled  then Toggles.WalkflingEnabled:SetValue(false)   end
        if Toggles.LagSwitchEnabled  then Toggles.LagSwitchEnabled:SetValue(false)   end
        if Toggles.FullbrightEnabled then Toggles.FullbrightEnabled:SetValue(false)  end
        if Options.WalkSpeed         then Options.WalkSpeed:SetValue(16)              end
        if Options.JumpPower         then Options.JumpPower:SetValue(50)              end
        StopFly()
        StopNoclip()
        SetHitbox(1)
        Library:Notify({ Title = "Global Kill", Description = "All features disabled.", Time = 3 })
    end
end

local FOVCircle = Drawing.new("Circle")
FOVCircle.Filled       = false
FOVCircle.Color        = Color3.fromRGB(255, 255, 255)
FOVCircle.Thickness    = 0.8
FOVCircle.Transparency = 0.2
FOVCircle.NumSides     = 64
FOVCircle.Visible      = false

local HMLines = {}
for i = 1, 4 do
    local l = Drawing.new("Line")
    l.Visible = false l.Transparency = 1
    HMLines[i] = l
end

local hitMarkerActive = false
local hitMarkerTimer  = 0

local function DrawHM()
    local cx = Camera.ViewportSize.X / 2
    local cy = Camera.ViewportSize.Y / 2
    local s  = Options.HitMarkerSize and Options.HitMarkerSize.Value or 8
    local pts = {
        { HMLines[1], cx-s, cy,   cx-3, cy   },
        { HMLines[2], cx+3, cy,   cx+s, cy   },
        { HMLines[3], cx,   cy-s, cx,   cy-3 },
        { HMLines[4], cx,   cy+3, cx,   cy+s },
    }
    for _, p in ipairs(pts) do
        p[1].Visible = true p[1].From = Vector2.new(p[2],p[3]) p[1].To = Vector2.new(p[4],p[5])
        p[1].Color = Color3.fromRGB(255,255,255) p[1].Thickness = 1.5 p[1].Transparency = 1
    end
end
local function HideHM() for _, l in ipairs(HMLines) do l.Visible = false end end

local function CleanupESP(entity)
    if not espObjects[entity] then return end
    for _, d in pairs(espObjects[entity]) do
        if d and typeof(d) == "userdata" and d.__OBJECT_EXISTS then d:Remove() end
    end
    espObjects[entity] = nil
end

local function CleanupAllESP()
    for entity in pairs(espObjects) do CleanupESP(entity) end
end

local function NewLine()
    local l = Drawing.new("Line") l.Visible = false l.Transparency = 1 return l
end

local function MakeESP(char)
    local joints    = GetJoints(char)
    local skelLines = {}
    for i = 1, #joints do skelLines[i] = NewLine() end
    espObjects[char] = {
        Box          = Drawing.new("Square"),
        BoxFill      = Drawing.new("Square"),
        CTL1=NewLine(),CTL2=NewLine(),CTR1=NewLine(),CTR2=NewLine(),
        CBL1=NewLine(),CBL2=NewLine(),CBR1=NewLine(),CBR2=NewLine(),
        Tracer       = NewLine(),
        NameText     = Drawing.new("Text"),
        DistText     = Drawing.new("Text"),
        HPBarBG      = Drawing.new("Square"),
        HPBar        = Drawing.new("Square"),
        HPText       = Drawing.new("Text"),
        TargetCircle = Drawing.new("Circle"),
        SkelLines    = skelLines,
        ArrowLines   = { NewLine(), NewLine(), NewLine() },
        FriendTag    = Drawing.new("Text"),
    }
end

local function DrawCorner(esp, x, y, w, h, col, thick)
    local cL = math.floor(math.min(w, h) * 0.22)
    local pts = {
        {esp.CTL1,x,y,x+cL,y},{esp.CTL2,x,y,x,y+cL},
        {esp.CTR1,x+w,y,x+w-cL,y},{esp.CTR2,x+w,y,x+w,y+cL},
        {esp.CBL1,x,y+h,x+cL,y+h},{esp.CBL2,x,y+h,x,y+h-cL},
        {esp.CBR1,x+w,y+h,x+w-cL,y+h},{esp.CBR2,x+w,y+h,x+w,y+h-cL},
    }
    for _, p in ipairs(pts) do
        if p[1].__OBJECT_EXISTS then
            p[1].Visible=true p[1].From=Vector2.new(p[2],p[3]) p[1].To=Vector2.new(p[4],p[5])
            p[1].Color=col p[1].Thickness=thick p[1].Transparency=1
        end
    end
end

local function HideCorner(esp)
    for _, k in ipairs({"CTL1","CTL2","CTR1","CTR2","CBL1","CBL2","CBR1","CBR2"}) do
        if esp[k] and esp[k].__OBJECT_EXISTS then esp[k].Visible = false end
    end
end

local function DrawArrow(lines, sp, col)
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    local dir = (sp - center).Unit
    local tip = center + dir * 65
    local perp = Vector2.new(-dir.Y, dir.X)
    local b1 = tip - dir*6 + perp*3
    local b2 = tip - dir*6 - perp*3
    local pts = {{lines[1],tip,b1},{lines[2],tip,b2},{lines[3],b1,b2}}
    for _, p in ipairs(pts) do
        if p[1].__OBJECT_EXISTS then
            p[1].Visible=true p[1].From=p[2] p[1].To=p[3]
            p[1].Color=col p[1].Thickness=1.2 p[1].Transparency=0.75
        end
    end
end

local function HideAllESP()
    for _, esp in pairs(espObjects) do
        local function h(k) if esp[k] and esp[k].__OBJECT_EXISTS then esp[k].Visible = false end end
        h("Box") h("BoxFill") h("Tracer") h("NameText") h("DistText")
        h("HPBarBG") h("HPBar") h("HPText") h("TargetCircle") h("FriendTag")
        HideCorner(esp)
        for _, l in ipairs(esp.SkelLines)  do if l.__OBJECT_EXISTS then l.Visible = false end end
        for _, l in ipairs(esp.ArrowLines) do if l.__OBJECT_EXISTS then l.Visible = false end end
    end
end

local function HookHealth(char)
    local hum = char:WaitForChild("Humanoid")
    Library:GiveSignal(hum.HealthChanged:Connect(function(hp)
        if Toggles.HitMarkerEnabled and Toggles.HitMarkerEnabled.Value and hp < hum.MaxHealth then
            hitMarkerActive = true
            hitMarkerTimer  = Options.HitMarkerDuration and Options.HitMarkerDuration.Value / 1000 or 0.1
        end
    end))
end

if LP.Character then HookHealth(LP.Character) end
Library:GiveSignal(LP.CharacterAdded:Connect(function(char)
    HookHealth(char)
    stickyTarget    = nil
    entityCache     = {}
    entityCacheTime = 0
    SetHitbox(Options.HitboxMultiplier and Options.HitboxMultiplier.Value or 1)
    if Toggles.FlyEnabled and Toggles.FlyEnabled.Value    then task.wait(0.5) StartFly()    end
    if Toggles.NoclipEnabled and Toggles.NoclipEnabled.Value then task.wait(0.5) StartNoclip() end
end))

Library:GiveSignal(RunService.RenderStepped:Connect(function(dt)
    if Library.Toggled or GlobalKillActive then
        HideAllESP()
        FOVCircle.Visible = false
        HideHM()
        return
    end

    espFrameCount = espFrameCount + 1
    visFrameCount = visFrameCount + 1

    local vp     = Camera.ViewportSize
    local center = Vector2.new(vp.X / 2, vp.Y / 2)

    if hitMarkerActive then
        hitMarkerTimer = hitMarkerTimer - dt
        DrawHM()
        if hitMarkerTimer <= 0 then hitMarkerActive = false HideHM() end
    end

    local aimbotOn = Toggles.AimbotEnabled and Toggles.AimbotEnabled.Value
    if aimbotOn then
        FOVCircle.Visible  = Toggles.AimbotShowFOV and Toggles.AimbotShowFOV.Value or false
        FOVCircle.Radius   = Options.AimbotFOV and Options.AimbotFOV.Value or 120
        FOVCircle.Position = center
        local target = GetAimbotTarget()
        if target then
            local partName = Options.AimbotTargetPart and Options.AimbotTargetPart.Value or "Head"
            local part = target:FindFirstChild(partName) or target:FindFirstChild("Head") or target:FindFirstChild("HumanoidRootPart")
            if part then
                local useRage = Toggles.AimbotRage and Toggles.AimbotRage.Value
                if useRage then
                    Camera.CFrame = CFrame.new(Camera.CFrame.Position, part.Position)
                else
                    local smooth  = Options.AimbotSmoothing and Options.AimbotSmoothing.Value or 8
                    Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, part.Position), math.min(dt * smooth, 1))
                end
            end
        end
    else
        FOVCircle.Visible = false
    end

    if Toggles.TriggerbotEnabled and Toggles.TriggerbotEnabled.Value then
        local mouse   = LP:GetMouse()
        local target  = mouse.Target
        if target then
            local targetChar = Players:GetPlayerFromCharacter(target.Parent)
            if targetChar and targetChar ~= LP then
                local minDelay = Options.TriggerbotMinDelay and Options.TriggerbotMinDelay.Value or 50
                local maxDelay = Options.TriggerbotMaxDelay and Options.TriggerbotMaxDelay.Value or 120
                local delay    = math.random(minDelay, maxDelay) / 1000
                task.delay(delay, function()
                    if Toggles.TriggerbotEnabled and Toggles.TriggerbotEnabled.Value then
                        mouse:Button1Down()
                        task.wait(0.05)
                        mouse:Button1Up()
                    end
                end)
            end
        end
    end

    if espFrameCount < 2 then return end
    espFrameCount = 0

    local espOn  = Toggles.ESPEnabled and Toggles.ESPEnabled.Value
    local lpChar = LP.Character
    local lpHRP  = lpChar and lpChar:FindFirstChild("HumanoidRootPart")
    local valid  = {}

    for _, data in ipairs(GetEntities()) do
        local char     = data.char
        local hum      = data.hum
        local hrp      = data.hrp
        local plr      = data.player
        local isFriend = data.isFriend
        local isBot    = data.isBot or false

        if char and char.Parent and hrp then
        local maxDist = isBot
            and (Options.BotESPMaxDistance and Options.BotESPMaxDistance.Value or 500)
            or  (Options.ESPMaxDistance    and Options.ESPMaxDistance.Value    or 1000)

        if not lpHRP or (lpHRP.Position - hrp.Position).Magnitude <= maxDist then
        local showESP = isBot
            and (Toggles.BotESPEnabled and Toggles.BotESPEnabled.Value)
            or  (espOn and not isBot)

        if showESP then
        local skipTeamESP = not isBot and Toggles.ESPTeamCheck and Toggles.ESPTeamCheck.Value and plr and LP.Team ~= nil and plr.Team == LP.Team
        if not skipTeamESP then

        local hrpSP, onScreen = Camera:WorldToViewportPoint(hrp.Position)

        if not espObjects[char] then MakeESP(char) end
        local esp = espObjects[char]

        local function hideAll()
            local function h(k) if esp[k] and esp[k].__OBJECT_EXISTS then esp[k].Visible = false end end
            h("Box") h("BoxFill") h("Tracer") h("NameText") h("DistText")
            h("HPBarBG") h("HPBar") h("HPText") h("TargetCircle") h("FriendTag")
            HideCorner(esp)
            for _, l in ipairs(esp.SkelLines)  do if l.__OBJECT_EXISTS then l.Visible = false end end
        end

        if not onScreen then
            hideAll()
            if not isBot and Toggles.ESPOffScreenArrows and Toggles.ESPOffScreenArrows.Value then
                local col = isFriend and Color3.fromRGB(100, 180, 255) or SafeColor(Options.ESPBoxColor and Options.ESPBoxColor.Value)
                DrawArrow(esp.ArrowLines, Vector2.new(math.clamp(hrpSP.X,40,vp.X-40), math.clamp(hrpSP.Y,40,vp.Y-40)), col)
            else
                for _, l in ipairs(esp.ArrowLines) do if l.__OBJECT_EXISTS then l.Visible = false end end
            end
        else
            for _, l in ipairs(esp.ArrowLines) do if l.__OBJECT_EXISTS then l.Visible = false end end

            local drawOk = true
            if not isBot and Toggles.ESPVisibleOnly and Toggles.ESPVisibleOnly.Value then
                if visFrameCount >= 4 then
                    visCache[char] = CanSee(Camera.CFrame.Position, hrp.Position, { lpChar, char })
                end
                if not visCache[char] then drawOk = false end
            end

            if not drawOk then
                hideAll()
            else
                valid[char] = true

                local topWorld, botWorld, midWorld = GetModelBounds(char)
                local topSP, topOn = Camera:WorldToViewportPoint(topWorld)
                local botSP, botOn = Camera:WorldToViewportPoint(botWorld)
                local midSP, _     = Camera:WorldToViewportPoint(midWorld)

                if not topOn or not botOn then
                    hideAll()
                else
                    local boxH  = math.abs(botSP.Y - topSP.Y)
                    local boxW  = math.max(boxH / 2.2, 20)
                    local boxX  = midSP.X - boxW / 2
                    local boxY  = math.min(topSP.Y, botSP.Y)
                    local hpPct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)

                    local col
                    if isFriend then
                        col = Color3.fromRGB(100, 180, 255)
                    elseif isBot then
                        col = Color3.fromRGB(186, 85, 211)
                    else
                        col = SafeColor(Options.ESPBoxColor and Options.ESPBoxColor.Value)
                    end

                    if Toggles.ESPBoxFilled and Toggles.ESPBoxFilled.Value and esp.BoxFill.__OBJECT_EXISTS then
                        esp.BoxFill.Visible      = true
                        esp.BoxFill.Size         = Vector2.new(boxW, boxH)
                        esp.BoxFill.Position     = Vector2.new(boxX, boxY)
                        esp.BoxFill.Color        = col
                        esp.BoxFill.Filled       = true
                        esp.BoxFill.Transparency = Options.ESPBoxFillAlpha and Options.ESPBoxFillAlpha.Value / 100 or 0.06
                    else
                        if esp.BoxFill.__OBJECT_EXISTS then esp.BoxFill.Visible = false end
                    end

                    local boxStyle = Options.ESPBoxType and Options.ESPBoxType.Value or "Corner"
                    if Toggles.ESPBox and Toggles.ESPBox.Value then
                        if boxStyle == "Corner" then
                            if esp.Box.__OBJECT_EXISTS then esp.Box.Visible = false end
                            DrawCorner(esp, boxX, boxY, boxW, boxH, col, 1.2)
                        else
                            HideCorner(esp)
                            if esp.Box.__OBJECT_EXISTS then
                                esp.Box.Visible=true esp.Box.Size=Vector2.new(boxW,boxH)
                                esp.Box.Position=Vector2.new(boxX,boxY) esp.Box.Color=col
                                esp.Box.Thickness=1.2 esp.Box.Filled=false esp.Box.Transparency=1
                            end
                        end
                    else
                        if esp.Box.__OBJECT_EXISTS then esp.Box.Visible = false end
                        HideCorner(esp)
                    end

                    if not isBot and Toggles.ESPTracer and Toggles.ESPTracer.Value and esp.Tracer.__OBJECT_EXISTS then
                        local tracerCol = SafeColor(Options.ESPTracerColor and Options.ESPTracerColor.Value, col)
                        local origin = (Options.ESPTracerOrigin and Options.ESPTracerOrigin.Value == "Bottom")
                            and Vector2.new(vp.X/2, vp.Y) or center
                        esp.Tracer.Visible=true esp.Tracer.From=origin
                        esp.Tracer.To=Vector2.new(midSP.X, botSP.Y)
                        esp.Tracer.Color=tracerCol esp.Tracer.Thickness=0.8 esp.Tracer.Transparency=0.7
                    else
                        if esp.Tracer.__OBJECT_EXISTS then esp.Tracer.Visible = false end
                    end

                    if isFriend and esp.FriendTag.__OBJECT_EXISTS then
                        esp.FriendTag.Visible      = true
                        esp.FriendTag.Text         = "[FRIEND] " .. (plr and plr.Name or "?")
                        esp.FriendTag.Position     = Vector2.new(midSP.X, boxY - 14)
                        esp.FriendTag.Color        = Color3.fromRGB(180, 230, 255)
                        esp.FriendTag.Size         = 12
                        esp.FriendTag.Center       = true
                        esp.FriendTag.Outline      = true
                        esp.FriendTag.Transparency = 1
                        if esp.NameText.__OBJECT_EXISTS then esp.NameText.Visible = false end
                    elseif Toggles.ESPName and Toggles.ESPName.Value and esp.NameText.__OBJECT_EXISTS then
                        esp.FriendTag.Visible      = false
                        esp.NameText.Visible       = true
                        esp.NameText.Text          = plr and plr.Name or char.Name
                        esp.NameText.Position      = Vector2.new(midSP.X, boxY - 13)
                        esp.NameText.Color         = Color3.fromRGB(255, 255, 255)
                        esp.NameText.Size          = 12
                        esp.NameText.Center        = true
                        esp.NameText.Outline       = true
                        esp.NameText.Transparency  = 1
                    else
                        if esp.NameText.__OBJECT_EXISTS  then esp.NameText.Visible  = false end
                        if esp.FriendTag.__OBJECT_EXISTS then esp.FriendTag.Visible = false end
                    end

                    if Toggles.ESPDistance and Toggles.ESPDistance.Value and lpHRP and esp.DistText.__OBJECT_EXISTS then
                        local dist = (lpHRP.Position - hrp.Position).Magnitude
                        esp.DistText.Visible=true esp.DistText.Text=string.format("%.0fm",dist)
                        esp.DistText.Position=Vector2.new(midSP.X, boxY+boxH+2)
                        esp.DistText.Color=Color3.fromRGB(160,210,255)
                        esp.DistText.Size=10 esp.DistText.Center=true
                        esp.DistText.Outline=true esp.DistText.Transparency=1
                    else
                        if esp.DistText.__OBJECT_EXISTS then esp.DistText.Visible = false end
                    end

                    local barThick = 3
                    local barX     = boxX - barThick - 3
                    local fillH    = math.max(2, boxH * hpPct)
                    local deadFade = hpPct <= 0 and 0 or 1

                    if Toggles.ESPHealthBar and Toggles.ESPHealthBar.Value then
                        if esp.HPBarBG.__OBJECT_EXISTS then
                            esp.HPBarBG.Visible=true esp.HPBarBG.Size=Vector2.new(barThick,boxH)
                            esp.HPBarBG.Position=Vector2.new(barX,boxY)
                            esp.HPBarBG.Color=Color3.fromRGB(15,15,15)
                            esp.HPBarBG.Filled=true esp.HPBarBG.Transparency=1
                        end
                        if esp.HPBar.__OBJECT_EXISTS then
                            esp.HPBar.Visible=true esp.HPBar.Size=Vector2.new(barThick,fillH)
                            esp.HPBar.Position=Vector2.new(barX,boxY+boxH-fillH)
                            esp.HPBar.Color=HPColor(hpPct) esp.HPBar.Filled=true
                            esp.HPBar.Transparency=deadFade
                        end
                        if Toggles.ESPHealthNumerical and Toggles.ESPHealthNumerical.Value and esp.HPText.__OBJECT_EXISTS then
                            esp.HPText.Visible=true esp.HPText.Text=math.floor(hum.Health).."hp"
                            esp.HPText.Position=Vector2.new(barX-1,boxY+boxH/2-5)
                            esp.HPText.Color=Color3.fromRGB(255,255,255)
                            esp.HPText.Size=10 esp.HPText.Center=true
                            esp.HPText.Outline=true esp.HPText.Transparency=1
                        else
                            if esp.HPText.__OBJECT_EXISTS then esp.HPText.Visible = false end
                        end
                    else
                        if esp.HPBarBG.__OBJECT_EXISTS then esp.HPBarBG.Visible = false end
                        if esp.HPBar.__OBJECT_EXISTS   then esp.HPBar.Visible   = false end
                        if esp.HPText.__OBJECT_EXISTS  then esp.HPText.Visible  = false end
                    end

                    if Toggles.ESPSkeleton and Toggles.ESPSkeleton.Value then
                        local joints = GetJoints(char)
                        local upperCol = SafeColor(Options.ESPSkelUpperColor and Options.ESPSkelUpperColor.Value, Color3.fromRGB(220,220,220))
                        local lowerCol = SafeColor(Options.ESPSkelLowerColor and Options.ESPSkelLowerColor.Value, Color3.fromRGB(180,180,255))
                        local count = math.min(#joints, #esp.SkelLines)
                        for i = 1, count do
                            local joint = joints[i]
                            local pA = char:FindFirstChild(joint[1])
                            local pB = char:FindFirstChild(joint[2])
                            local ln = esp.SkelLines[i]
                            if pA and pB and ln.__OBJECT_EXISTS then
                                local sA, onA = Camera:WorldToViewportPoint(pA.Position)
                                local sB, onB = Camera:WorldToViewportPoint(pB.Position)
                                if onA and onB then
                                    ln.Visible=true
                                    ln.From=Vector2.new(sA.X,sA.Y) ln.To=Vector2.new(sB.X,sB.Y)
                                    ln.Color=joint[3]=="upper" and upperCol or lowerCol
                                    ln.Thickness=0.8 ln.Transparency=0.85
                                else
                                    ln.Visible = false
                                end
                            else
                                if ln.__OBJECT_EXISTS then ln.Visible = false end
                            end
                        end
                        for i = count+1, #esp.SkelLines do
                            if esp.SkelLines[i].__OBJECT_EXISTS then esp.SkelLines[i].Visible = false end
                        end
                    else
                        for _, l in ipairs(esp.SkelLines) do if l.__OBJECT_EXISTS then l.Visible = false end end
                    end

                    local isLocked = stickyTarget == char
                    if Toggles.ESPTargetCircle and Toggles.ESPTargetCircle.Value and isLocked and esp.TargetCircle.__OBJECT_EXISTS then
                        local head    = char:FindFirstChild("Head")
                        local headPos = head and head.Position or topWorld
                        local hSP, hOn = Camera:WorldToViewportPoint(headPos)
                        if hOn then
                            esp.TargetCircle.Visible=true
                            esp.TargetCircle.Position=Vector2.new(hSP.X,hSP.Y)
                            esp.TargetCircle.Radius=Options.ESPTargetCircleRadius and Options.ESPTargetCircleRadius.Value or 14
                            esp.TargetCircle.Color=Color3.fromRGB(255,200,0)
                            esp.TargetCircle.Filled=false esp.TargetCircle.Thickness=1.2
                            esp.TargetCircle.Transparency=0.85 esp.TargetCircle.NumSides=32
                        else
                            esp.TargetCircle.Visible = false
                        end
                    else
                        if esp.TargetCircle.__OBJECT_EXISTS then esp.TargetCircle.Visible = false end
                    end
                end
            end
        end
    end

    visFrameCount = visFrameCount >= 4 and 0 or visFrameCount

    for entity in pairs(espObjects) do
        if not valid[entity] or not entity.Parent then CleanupESP(entity) end
    end
end))

