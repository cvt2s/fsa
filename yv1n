Library:GiveSignal(RunService.RenderStepped:Connect(function(dt)
    espFrameCount  = espFrameCount + 1
    visFrameCount  = visFrameCount + 1

    local espEnabled    = Toggles.ESPEnabled and Toggles.ESPEnabled.Value
    local aimbotEnabled = Toggles.AimbotEnabled and Toggles.AimbotEnabled.Value
    if Toggles.AimbotEnabled and Toggles.AimbotEnabled.Value and not Library.Toggled then
        local target = GetAimbotTarget()
        if target then
            local partName = Options.AimbotTargetPart and Options.AimbotTargetPart.Value or "Head"
            local part     = target:FindFirstChild(partName) or target:FindFirstChild("Head") or target:FindFirstChild("HumanoidRootPart")
            if part then
                local smoothing  = Options.AimbotSmoothing and Options.AimbotSmoothing.Value or 10
                local targetCF   = CFrame.new(Camera.CFrame.Position, part.Position)
                Camera.CFrame    = Camera.CFrame:Lerp(targetCF, math.min(dt * smoothing, 1))
            end
        end
    end

    if espFrameCount < 2 then return end
    espFrameCount = 0

    local viewportSize = Camera.ViewportSize
    local screenBottom = Vector2.new(viewportSize.X / 2, viewportSize.Y)

    local entities = GetEntityCache()
    local validThisFrame = {}

    for _, data in ipairs(entities) do
        local char   = data.char
        local hum    = data.hum
        local hrp    = data.hrp
        local isBot  = data.isBot

        local skipEntity = false

        if not char or not char.Parent then skipEntity = true end

        if not skipEntity then
            local myHRP = GetHRP()
            if myHRP then
                local dist = (myHRP.Position - hrp.Position).Magnitude
                local maxDist = isBot
                    and (Options.BotESPMaxDistance and Options.BotESPMaxDistance.Value or 500)
                    or  (Options.ESPMaxDistance    and Options.ESPMaxDistance.Value    or 1000)
                if dist > maxDist then
                    if espObjects[char] then
                        for _, d in pairs(espObjects[char]) do
                            if d and d.Remove then d.Visible = false end
                        end
                    end
                    skipEntity = true
                end
            end
        end

        if not skipEntity then
            local hrpPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)

            if not onScreen then
                if espObjects[char] then
                    for _, d in pairs(espObjects[char]) do
                        if d then d.Visible = false end
                    end
                end
                skipEntity = true
            else
                local shouldDraw = (isBot and (Toggles.BotESPEnabled and Toggles.BotESPEnabled.Value))
                    or (espEnabled and not isBot)

                if not shouldDraw then
                    if espObjects[char] then
                        for _, d in pairs(espObjects[char]) do
                            if d then d.Visible = false end
                        end
                    end
                    skipEntity = true
                end

                if not skipEntity and Toggles.ESPTeamCheck and Toggles.ESPTeamCheck.Value and not isBot then
                    local plr = data.player
                    if plr and plr.Team == LP.Team then
                        if espObjects[char] then
                            for _, d in pairs(espObjects[char]) do if d then d.Visible = false end end
                        end
                        skipEntity = true
                    end
                end

                if not skipEntity and Toggles.ESPVisibleCheck and Toggles.ESPVisibleCheck.Value and not isBot then
                    if visFrameCount >= 4 then
                        visCache[char] = IsVisible(hrp.Position, char)
                    end
                    if not visCache[char] then
                        if espObjects[char] then
                            for _, d in pairs(espObjects[char]) do if d then d.Visible = false end end
                        end
                        skipEntity = true
                    end
                end

                if visFrameCount >= 4 then visFrameCount = 0 end
            end

            if not skipEntity then
                local hrpPos2, _ = Camera:WorldToViewportPoint(hrp.Position)
                local hrpPos = hrpPos2
                validThisFrame[char] = true

        local topPos, _    = Camera:WorldToViewportPoint(hrp.Position + Vector3.new(0, 3, 0))
        local botPos, _    = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3.5, 0))
        local boxHeight    = math.abs(topPos.Y - botPos.Y)
        local boxWidth     = boxHeight / 1.8
        local boxX         = hrpPos.X - boxWidth / 2
        local boxY         = hrpPos.Y - boxHeight / 2

        local hpPct        = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
        local hpColor      = HPColor(hpPct)

        local boxColor     = isBot and Color3.fromRGB(186, 85, 211) or (Options.ESPBoxColor and Options.ESPBoxColor.Value or Color3.fromRGB(255, 0, 0))

        if not espObjects[char] then
            espObjects[char] = {
                Box       = Drawing.new("Square"),
                Tracer    = Drawing.new("Line"),
                NameText  = Drawing.new("Text"),
                DistText  = Drawing.new("Text"),
                HPBar     = Drawing.new("Square"),
                HPBarBG   = Drawing.new("Square"),
                HPText    = Drawing.new("Text"),
            }
        end

        local esp = espObjects[char]
        local barThick = 3
        local barGap   = 3

            local showBox    = (isBot and (Toggles.BotESPBox and Toggles.BotESPBox.Value)) or (not isBot and (Toggles.ESPBoxEnabled and Toggles.ESPBoxEnabled.Value))
            local showTracer = not isBot and (Toggles.ESPTracerEnabled and Toggles.ESPTracerEnabled.Value)
            local showName   = (isBot and (Toggles.BotESPName and Toggles.BotESPName.Value)) or (not isBot and (Toggles.ESPNameEnabled and Toggles.ESPNameEnabled.Value))
            local showHP     = (isBot and (Toggles.BotESPHealth and Toggles.BotESPHealth.Value)) or (not isBot and (Toggles.ESPHealthBarEnabled and Toggles.ESPHealthBarEnabled.Value))
            local showHPNum  = (isBot and (Toggles.BotESPNumerical and Toggles.BotESPNumerical.Value)) or (not isBot and (Toggles.ESPHealthNumerical and Toggles.ESPHealthNumerical.Value))
            local showDist   = not isBot and (Toggles.ESPDistanceEnabled and Toggles.ESPDistanceEnabled.Value)

        esp.Box.Visible     = showBox
        esp.Box.Size        = Vector2.new(boxWidth, boxHeight)
        esp.Box.Position    = Vector2.new(boxX, boxY)
        esp.Box.Color       = boxColor
        esp.Box.Thickness   = 1.5
        esp.Box.Filled      = false
        esp.Box.Transparency = 1

        esp.Tracer.Visible      = showTracer
        esp.Tracer.From         = screenBottom
        esp.Tracer.To           = Vector2.new(hrpPos.X, hrpPos.Y)
        esp.Tracer.Color        = boxColor
        esp.Tracer.Thickness    = 1
        esp.Tracer.Transparency = 1

        local nameStr = isBot and ("[BOT] " .. char.Name) or ("[" .. (data.player and data.player.Name or "?") .. "]")
        esp.NameText.Visible      = showName
        esp.NameText.Text         = nameStr
        esp.NameText.Position     = Vector2.new(hrpPos.X, boxY - 14)
        esp.NameText.Color        = Color3.fromRGB(255, 255, 255)
        esp.NameText.Size         = 13
        esp.NameText.Center       = true
        esp.NameText.Outline      = true
        esp.NameText.Transparency = 1

        if showDist and GetHRP() then
            local dist = (GetHRP().Position - hrp.Position).Magnitude
            esp.DistText.Visible      = true
            esp.DistText.Text         = string.format("%.0f", dist) .. "m"
            esp.DistText.Position     = Vector2.new(hrpPos.X, boxY + boxHeight + 2)
            esp.DistText.Color        = Color3.fromRGB(0, 255, 255)
            esp.DistText.Size         = 11
            esp.DistText.Center       = true
            esp.DistText.Outline      = true
            esp.DistText.Transparency = 1
        else
            esp.DistText.Visible = false
        end

        local barX   = boxX - barThick - barGap
        local fillH  = math.max(2, boxHeight * hpPct)


        esp.HPBarBG.Visible      = showHP
        esp.HPBarBG.Size         = Vector2.new(barThick, boxHeight)
        esp.HPBarBG.Position     = Vector2.new(barX, boxY)
        esp.HPBarBG.Color        = Color3.fromRGB(20, 20, 20)
        esp.HPBarBG.Filled       = true
        esp.HPBarBG.Transparency = 1

        esp.HPBar.Visible      = showHP
        esp.HPBar.Size         = Vector2.new(barThick, fillH)
        esp.HPBar.Position     = Vector2.new(barX, boxY + boxHeight - fillH)
        esp.HPBar.Color        = hpColor
        esp.HPBar.Filled       = true
        esp.HPBar.Transparency = 1

        if showHPNum then
            esp.HPText.Visible      = true
            esp.HPText.Text         = math.floor(hum.Health) .. "hp"
            esp.HPText.Position     = Vector2.new(barX - 1, boxY + boxHeight / 2 - 6)
            esp.HPText.Color        = Color3.fromRGB(255, 255, 255)
            esp.HPText.Size         = 10
            esp.HPText.Center       = true
            esp.HPText.Outline      = true
            esp.HPText.Transparency = 1
        else
            esp.HPText.Visible = false
        end
            end
        end
    end

    for entity, _ in pairs(espObjects) do
        if not validThisFrame[entity] or not entity.Parent then
            CleanupESP(entity)
        end
    end
end))

