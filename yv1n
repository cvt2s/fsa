    local lines = {}
    for userId, data in pairs(WhitelistData) do
        local icon = data.status == "friend" and "👤" or data.status == "neutral" and "○" or "✕"
        local pFlag = data.priority and " [P]" or ""
        table.insert(lines, icon .. " " .. data.name .. " — " .. data.status .. pFlag)
    end
    if #lines == 0 then
        if WLListLabel and WLListLabel.SetText then WLListLabel:SetText("None assigned.") end
    else
        if WLListLabel and WLListLabel.SetText then WLListLabel:SetText(table.concat(lines, "\n")) end
