local ChatDisplayLabel = ChatSpyTab:AddLabel({ Text = "No messages yet.", DoesWrap = true })

local function UpdatePlayerInfo()
    local char = LP.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    local pos  = hrp and hrp.Position or Vector3.zero
    local data = {
        ["Name"]        = LP.Name,
        ["Display"]     = LP.DisplayName,
        ["User ID"]     = tostring(LP.UserId),
        ["Account Age"] = LP.AccountAge .. " days",
        ["Team"]        = LP.Team and LP.Team.Name or "None",
        ["Health"]      = (hum and math.floor(hum.Health) or "?") .. " / " .. (hum and math.floor(hum.MaxHealth) or "?"),
        ["Walk Speed"]  = tostring(hum and math.floor(hum.WalkSpeed) or "?"),
        ["Position"]    = string.format("%.1f, %.1f, %.1f", pos.X, pos.Y, pos.Z),
    }
    for field, ref in pairs(PlayerLabelRefs) do
        if ref and ref.SetText then ref:SetText(field .. ": " .. (data[field] or "?")) end
    end
end

local function UpdateServerInfo()
    local data = {
        ["Place ID"]       = tostring(game.PlaceId),
        ["Game ID"]        = tostring(game.GameId),
        ["Job ID"]         = game.JobId,
        ["Players"]        = #Players:GetPlayers() .. " / " .. Players.MaxPlayers,
        ["Place Version"]  = tostring(game.PlaceVersion),
        ["Creator ID"]     = tostring(game.CreatorId),
        ["Private Server"] = tostring(game.PrivateServerId ~= ""),
    }
    for field, ref in pairs(ServerLabelRefs) do
        if ref and ref.SetText then ref:SetText(field .. ": " .. (data[field] or "?")) end
    end
end

BuildPlayerInfoLabels()
