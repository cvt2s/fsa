local function GetAimTarget()
    local lpChar = LP.Character
    local lpHRP = lpChar and lpChar:FindFirstChild("HumanoidRootPart")
    if not lpHRP then return nil end

    local useTeam = Toggles.AimbotTeamCheck and Toggles.AimbotTeamCheck.Value
    local useVis = Toggles.AimbotVisCheck and Toggles.AimbotVisCheck.Value
    local useSticky = Toggles.AimbotStickyAim and Toggles.AimbotStickyAim.Value
    local useUUID = Toggles.AimbotUUIDLock and Toggles.AimbotUUIDLock.Value
    local fov = Options.AimbotFOV and Options.AimbotFOV.Value or 120
    local partName = Options.AimbotTargetPart and Options.AimbotTargetPart.Value or "Head"
    local priority = Options.AimbotPriority and Options.AimbotPriority.Value or "Closest to Crosshair"
    local center = ScreenCenter()

    if useTeam and not HasTeams() then
        if Toggles.AimbotEnabled and Toggles.AimbotEnabled.Value then
            Toggles.AimbotEnabled:SetValue(false)
            Library:Notify({Title = "Aimbot", Description = "No teams detected.\nDisabled automatically.", Time = 5})
        end
        return nil
    end

    if useUUID and aimLock then
        local hum = aimLock:FindFirstChildOfClass("Humanoid")
        local hrp = aimLock:FindFirstChild("HumanoidRootPart")
        if hum and hum.Health > 0 and hrp and aimLock.Parent then return aimLock end
        aimLock = nil aimLockUUID = nil aimNotifFired = false
        Library:Notify({Title = "Aimbot", Description = "UUID lock broken — target lost.", Time = 3})
    end

    if useSticky and not useUUID and aimLock then
        local hrp = aimLock:FindFirstChild("HumanoidRootPart")
        local hum = aimLock:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health > 0 and hrp and aimLock.Parent then
            local sp, on = Camera:WorldToViewportPoint(hrp.Position)
            if on and (Vector2.new(sp.X, sp.Y) - center).Magnitude <= fov then return aimLock end
        end
        aimLock = nil aimLockUUID = nil aimNotifFired = false
    end

    if not useSticky and not useUUID then
        aimLock = nil aimLockUUID = nil aimNotifFired = false
    end

    local bestScore = math.huge
    local bestChar = nil
    local bestPlr = nil

    for _, data in ipairs(GetEntities()) do
        if not data.isFriend then
            local skip = useTeam and SameTeam(LP, data.player)
            if not skip then
                local part = data.char:FindFirstChild(partName) or data.char:FindFirstChild("Head") or data.hrp
                if part then
                    local sp, on = Camera:WorldToViewportPoint(part.Position)
                    if on then
                        local sd = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                        if sd <= fov then
                            local canHit = true
                            if useVis then canHit = CanSee(Camera.CFrame.Position, part.Position, {lpChar, data.char}) end
                            if canHit then
                                local score
                                if priority == "Lowest HP" then score = data.hum.Health
                                elseif priority == "Closest Distance" then score = (lpHRP.Position - data.hrp.Position).Magnitude
                                else score = sd end
                                if score < bestScore or (data.isPriority and bestChar == nil) then
                                    bestScore = score
                                    bestChar = data.char
                                    bestPlr = data.player
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    if bestChar and bestPlr then
        local uuid = tostring(bestPlr.UserId)
        if uuid ~= aimLockUUID then
            aimLock = bestChar
            aimLockUUID = uuid
            aimNotifFired = false
            RecordTargetHistory(bestPlr)
            HookKillNotif(bestChar, bestPlr)
        end
        if (useUUID or useSticky) and not aimNotifFired then
            aimNotifFired = true
            Library:Notify({
                Title = "Aimbot — Locked",
                Description = "Target: " .. bestPlr.Name .. "\nUUID: " .. uuid .. "\nMode: " .. (useUUID and "UUID" or "Sticky"),
                Time = 6,
            })
        end
    end

    return bestChar
end

local function GetSilentTarget()
    local now = tick()
    if now - SilentAimCacheTime < 0.016 then return SilentAimCache end
    SilentAimCacheTime = now
    local fov = Options.SilentAimFOV and Options.SilentAimFOV.Value or 150
    local partName = Options.SilentAimPart and Options.SilentAimPart.Value or "Head"
    local useTeam = Toggles.SilentAimTeam and Toggles.SilentAimTeam.Value or false
    local center = ScreenCenter()
    local best = fov
    local closest = nil
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then
            local ws = GetWLStatus(plr)
            if ws ~= "neutral" and ws ~= "friend" then
                local skip = useTeam and LP.Team ~= nil and plr.Team == LP.Team
                if not skip then
                    local char = plr.Character
                    if char then
                        local part = char:FindFirstChild(partName) or char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
                        local hum = char:FindFirstChildOfClass("Humanoid")
                        if part and hum and hum.Health > 0 then
                            local sp, on = Camera:WorldToViewportPoint(part.Position)
                            if on then
                                local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                                if d < best then best = d closest = part end
                            end
                        end
                    end
                end
            end
        end
    end
    SilentAimCache = closest
    return closest
end

local function EnableSilentAim()
    if SilentAimHook then return end
    if not hookmetamethod then
        Library:Notify({Title = "Silent Aim", Description = "hookmetamethod unavailable.", Time = 4})
        return
    end
    local playerMouse = LP:GetMouse()
    local oldNC
    oldNC = hookmetamethod(game, "__namecall", function(...)
        local args = {...}
        local method = getnamecallmethod()
        if Toggles.SilentAimEnabled and Toggles.SilentAimEnabled.Value and args[1] == workspace then
            local target = GetSilentTarget()
            if target then
                if method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRay" then
                    local ray = args[2]
                    if typeof(ray) == "Ray" then
                        args[2] = Ray.new(ray.Origin, (target.Position - ray.Origin).Unit * ray.Direction.Magnitude)
                        return oldNC(unpack(args))
                    end
                elseif method == "FindPartOnRayWithWhitelist" then
                    local ray = args[2]
                    if typeof(ray) == "Ray" then
                        args[2] = Ray.new(ray.Origin, (target.Position - ray.Origin).Unit * ray.Direction.Magnitude)
                        return oldNC(unpack(args))
                    end
                elseif method == "Raycast" then
                    if typeof(args[2]) == "Vector3" and typeof(args[3]) == "Vector3" then
                        args[3] = (target.Position - args[2]).Unit * args[3].Magnitude
                        return oldNC(unpack(args))
                    end
                end
            end
        end
        return oldNC(unpack(args))
    end)
    SilentAimHook = oldNC
    local oldIdx
    oldIdx = hookmetamethod(game, "__index", function(t, k)
        if Toggles.SilentAimEnabled and Toggles.SilentAimEnabled.Value and t == playerMouse then
            local target = GetSilentTarget()
            if target then
                if k == "Target" then return target end
                if k == "Hit" then return CFrame.new(target.Position) end
            end
        end
        return oldIdx(t, k)
    end)
    SilentAimIndexHook = oldIdx
end

