local function HasTeams()
    local now = tick()
    if teamCache ~= nil and (now - teamCacheTime) < TEAM_TTL then return teamCache end
    local count = 0
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Team ~= nil then count = count + 1 end
    end
    teamCache = count >= 2
    teamCacheTime = now
    return teamCache
end

local function SameTeam(a, b)
    return a.Team ~= nil and b.Team ~= nil and a.Team == b.Team
end

local function CanSee(origin, target, ignore)
    rayParams.FilterDescendantsInstances = ignore
    return workspace:Raycast(origin, target - origin, rayParams) == nil
end

