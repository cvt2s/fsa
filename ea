local function GetRadarCenter()
    return Vector2.new(RADAR_X + RADAR_SIZE/2, RADAR_Y + RADAR_SIZE/2)
end

local function GetRadarRotAngle()
    local mode = Options.RadarRotation and Options.RadarRotation.Value or "Camera"
    if mode == "Fixed (North Up)" then return 0 end
    local look = Camera.CFrame.LookVector
    return math.atan2(look.X, look.Z)
end

local function WorldToRadar(worldPos, lpHRP, range, rotAngle, shape)
    local rel = worldPos - lpHRP.Position
    local dx = rel.X
    local dz = rel.Z
    local dist = math.sqrt(dx*dx + dz*dz)
    local half = RADAR_SIZE / 2
    local cos = math.cos(rotAngle)
    local sin = math.sin(rotAngle)
    local rx = dx * cos + dz * sin
    local ry = -dx * sin + dz * cos
    local px, py
    if range <= 0 then
        local safeDist = math.max(dist, 0.01)
        px = (rx / safeDist) * half * 0.9
        py = (ry / safeDist) * half * 0.9
    else
        px = (rx / range) * half
        py = (ry / range) * half
    end
    if shape == "Square" then
        px = math.clamp(px, -half+6, half-6)
        py = math.clamp(py, -half+6, half-6)
    else
        local mag = math.sqrt(px*px + py*py)
        if mag > half-6 then px = px/mag*(half-6) py = py/mag*(half-6) end
    end
    local center = GetRadarCenter()
    return Vector2.new(center.X+px, center.Y+py), dist
end

local function DrawRadarSelfArrow(center)
    local mode = Options.RadarRotation and Options.RadarRotation.Value or "Camera"
    local angle = 0
    if mode == "Fixed (North Up)" then
        local look = Camera.CFrame.LookVector
        angle = -math.atan2(look.X, look.Z)
    end
    local size = 7
    local ax = math.sin(angle) local ay = -math.cos(angle)
    local px = math.cos(angle) local py = math.sin(angle)
    radarSelfDot.PointA = Vector2.new(center.X+ax*size, center.Y+ay*size)
    radarSelfDot.PointB = Vector2.new(center.X-ax*size+px*size*0.5, center.Y-ay*size+py*size*0.5)
    radarSelfDot.PointC = Vector2.new(center.X-ax*size-px*size*0.5, center.Y-ay*size-py*size*0.5)
    radarSelfDot.Visible = true
end

local function RadarProximityColor(dist, range)
    local maxD = range > 0 and range or 200
    local t = math.clamp(1-(dist/maxD), 0, 1)
    if t > 0.66 then local f = (t-0.66)/0.34 return Color3.new(1, 1-f, 0)
    elseif t > 0.33 then local f = (t-0.33)/0.33 return Color3.new(1, 0.4+f*0.3, 0) end
    return Color3.fromRGB(255, 60, 60)
end

local function GetRadarDotColor(plr, dist, range, isFFA)
    if isFFA then
        if Toggles.RadarHeatMap and Toggles.RadarHeatMap.Value then return RadarProximityColor(dist, range) end
        return Color3.fromRGB(255, 60, 60)
    end
    if plr.Team == nil then return Color3.fromRGB(160, 160, 160) end
    if LP.Team ~= nil and plr.Team == LP.Team then return Color3.fromRGB(80, 160, 255) end
    return Color3.fromRGB(255, 60, 60)
end

