local function MakeESP(char)
    local joints = GetJoints(char)
    local sk = {}
    for i = 1, #joints do sk[i] = NewLine() end
    espObjects[char] = {
        Box = Drawing.new("Square"), BoxFill = Drawing.new("Square"),
        CTL1 = NewLine(), CTL2 = NewLine(), CTR1 = NewLine(), CTR2 = NewLine(),
        CBL1 = NewLine(), CBL2 = NewLine(), CBR1 = NewLine(), CBR2 = NewLine(),
        Tracer = NewLine(), NameText = Drawing.new("Text"), DistText = Drawing.new("Text"),
        HPBarBG = Drawing.new("Square"), HPBar = Drawing.new("Square"), HPText = Drawing.new("Text"),
        TargetCircle = Drawing.new("Circle"), SkelLines = sk,
        ArrowLines = {NewLine(), NewLine(), NewLine()}, FriendTag = Drawing.new("Text"),
    }
    local function forceHide()
        local esp = espObjects[char]
        if not esp then return end
        local function h(k) if esp[k] and esp[k].__OBJECT_EXISTS then esp[k].Visible = false end end
        h("Box") h("BoxFill") h("Tracer") h("NameText") h("DistText") h("HPBarBG") h("HPBar") h("HPText") h("TargetCircle") h("FriendTag")
        HideCorner(esp)
        for _, l in ipairs(esp.SkelLines)  do if l.__OBJECT_EXISTS then l.Visible = false end end
        for _, l in ipairs(esp.ArrowLines) do if l.__OBJECT_EXISTS then l.Visible = false end end
    end
    char.AncestryChanged:Connect(function()
        if not char.Parent then
            forceHide()
            task.defer(function() CleanupESP(char) end)
        end
    end)
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.Died:Connect(function()
            forceHide()
            entityCache = {}
            entityCacheTime = 0
            task.delay(0.5, function() CleanupESP(char) end)
        end)
    end
end

local function CleanupESP(entity)
    if not espObjects[entity] then return end
    for _, d in pairs(espObjects[entity]) do
        if type(d) == "table" then
            for _, l in ipairs(d) do if l and l.__OBJECT_EXISTS then l:Remove() end end
        elseif d and typeof(d) == "userdata" and d.__OBJECT_EXISTS then
            d:Remove()
        end
    end
    espObjects[entity] = nil
    boundsCache[entity] = nil boundsCacheTime[entity] = nil
    visCache[entity] = nil visCacheTime[entity] = nil
end

