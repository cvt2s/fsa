local function StopFly()
    if FlyConnection then FlyConnection:Disconnect() FlyConnection = nil end
    if FlyBodyVel then FlyBodyVel:Destroy() FlyBodyVel = nil end
    if FlyBodyGyro then FlyBodyGyro:Destroy() FlyBodyGyro = nil end
    local hrp = GetHRP()
    if hrp then hrp.AssemblyLinearVelocity = Vector3.zero end
end

local function StartFly()
    StopFly()
    local hrp = GetHRP()
    if not hrp then return end
    FlyBodyVel = Instance.new("BodyVelocity")
    FlyBodyVel.Velocity = Vector3.zero
    FlyBodyVel.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    FlyBodyVel.P = 1e4
    FlyBodyVel.Parent = hrp
    FlyBodyGyro = Instance.new("BodyGyro")
    FlyBodyGyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    FlyBodyGyro.P = 1e4
    FlyBodyGyro.D = 100
    FlyBodyGyro.CFrame = hrp.CFrame
    FlyBodyGyro.Parent = hrp
    local vel = Vector3.zero
    FlyConnection = RunService.RenderStepped:Connect(function(dt)
        if not Toggles.FlyEnabled.Value then StopFly() return end
        local spd = Options.FlySpeed.Value
        local cam = workspace.CurrentCamera
        local dir = Vector3.zero
        if UIS:IsKeyDown(Enum.KeyCode.W) then dir = dir + cam.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.S) then dir = dir - cam.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.A) then dir = dir - cam.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.D) then dir = dir + cam.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0, 1, 0) end
        if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then dir = dir - Vector3.new(0, 1, 0) end
        local tv = dir.Magnitude > 0 and dir.Unit * spd or Vector3.zero
        vel = vel:Lerp(tv, math.min(dt * 12, 1))
        FlyBodyVel.Velocity = vel
        FlyBodyGyro.CFrame = cam.CFrame
    end)
end

local function StopNoclip()
    if NoclipConn then NoclipConn:Disconnect() NoclipConn = nil end
    if FloatBody then FloatBody:Destroy() FloatBody = nil end
    local char = LP.Character
    if not char then return end
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then p.CanCollide = true end
    end
end

local function StartNoclip()
    StopNoclip()
    local hrp = GetHRP()
    local ty = hrp and hrp.Position.Y or 0
    if Toggles.NoclipFloat and Toggles.NoclipFloat.Value and hrp then
        FloatBody = Instance.new("BodyPosition")
        FloatBody.Position = Vector3.new(hrp.Position.X, ty, hrp.Position.Z)
        FloatBody.MaxForce = Vector3.new(0, 1e9, 0)
        FloatBody.P = 5000
        FloatBody.D = 500
        FloatBody.Parent = hrp
    end
    NoclipConn = RunService.Stepped:Connect(function()
        if not Toggles.NoclipEnabled.Value then StopNoclip() return end
        local char = LP.Character
        if not char then return end
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
        if FloatBody then
            local n = GetHRP()
            if n then FloatBody.Position = Vector3.new(n.Position.X, ty, n.Position.Z) end
        end
    end)
end

local function DoWalkfling()
    if WalkflingCooldown then return end
    local hum = GetHum()
    if not hum then return end
    WalkflingCooldown = true
    local orig = hum.WalkSpeed
    hum.WalkSpeed = Options.WalkflingSpeed.Value
    task.wait(Options.WalkflingDuration.Value / 1000)
    hum.WalkSpeed = orig
    task.wait(0.3)
    WalkflingCooldown = false
end

local function HookChat()
    if ChatHooked then return end
    ChatHooked = true
    pcall(function()
        if TextChatService.ChatVersion == Enum.ChatVersion.LegacyChatService then
            for _, p in ipairs(Players:GetPlayers()) do
                p.Chatted:Connect(function(m)
                    if Toggles.ChatSpyEnabled and Toggles.ChatSpyEnabled.Value then
                        table.insert(ChatMessages, "[" .. p.Name .. "]: " .. m)
                        if #ChatMessages > 50 then table.remove(ChatMessages, 1) end
                    end
                end)
            end
            Players.PlayerAdded:Connect(function(p)
                p.Chatted:Connect(function(m)
                    if Toggles.ChatSpyEnabled and Toggles.ChatSpyEnabled.Value then
                        table.insert(ChatMessages, "[" .. p.Name .. "]: " .. m)
                        if #ChatMessages > 50 then table.remove(ChatMessages, 1) end
                    end
                end)
            end)
        else
            TextChatService.MessageReceived:Connect(function(msg)
