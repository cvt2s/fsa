local function BuildPlayerInfo()
    for _, f in ipairs({"Name","Display","User ID","Account Age","Team","Health","Walk Speed","Position"}) do
        PlayerLabelRefs[f] = PlayerInfoTab:AddLabel({Text=f..": ...", DoesWrap=false})
    end
end
local function BuildServerInfo()
    for _, f in ipairs({"Place ID","Game ID","Job ID","Players","Place Version"}) do
        ServerLabelRefs[f] = ServerInfoTab:AddLabel({Text=f..": ...", DoesWrap=false})
    end
end
local function UpdatePlayerInfo()
    local char=LP.Character local hrp=char and char:FindFirstChild("HumanoidRootPart")
    local hum=char and char:FindFirstChildOfClass("Humanoid") local pos=hrp and hrp.Position or Vector3.zero
    local d={["Name"]=LP.Name,["Display"]=LP.DisplayName,["User ID"]=tostring(LP.UserId),["Account Age"]=LP.AccountAge.." days",
        ["Team"]=LP.Team and LP.Team.Name or "None",
        ["Health"]=(hum and math.floor(hum.Health) or "?").." / "..(hum and math.floor(hum.MaxHealth) or "?"),
        ["Walk Speed"]=tostring(hum and math.floor(hum.WalkSpeed) or "?"),
        ["Position"]=string.format("%.1f, %.1f, %.1f",pos.X,pos.Y,pos.Z)}
    for f, ref in pairs(PlayerLabelRefs) do if ref and ref.SetText then ref:SetText(f..": "..(d[f] or "?")) end end
end
local function UpdateServerInfo()
    local d={["Place ID"]=tostring(game.PlaceId),["Game ID"]=tostring(game.GameId),["Job ID"]=game.JobId,
        ["Players"]=#Players:GetPlayers().." / "..Players.MaxPlayers,["Place Version"]=tostring(game.PlaceVersion)}
    for f, ref in pairs(ServerLabelRefs) do if ref and ref.SetText then ref:SetText(f..": "..(d[f] or "?")) end end
end
BuildPlayerInfo() BuildServerInfo() UpdatePlayerInfo() UpdateServerInfo()

