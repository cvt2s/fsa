local function GetModelBounds(char)
    local now = tick()
    if boundsCache[char] and (now - (boundsCacheTime[char] or 0)) < BOUNDS_TTL then
        return table.unpack(boundsCache[char])
    end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local head = char:FindFirstChild("Head")
    local top, bot, mid
    if hrp and head then
        local hy = math.max(hrp.Position.Y, head.Position.Y) + 1
        local by = hrp.Position.Y - 3
        mid = hrp.Position
        top = Vector3.new(mid.X, hy, mid.Z)
        bot = Vector3.new(mid.X, by, mid.Z)
    elseif hrp then
        mid = hrp.Position
        top = mid + Vector3.new(0, 2.8, 0)
        bot = mid - Vector3.new(0, 3, 0)
    else
        return Vector3.zero, Vector3.zero, Vector3.zero
    end
    boundsCache[char] = {top, bot, mid}
    boundsCacheTime[char] = now
    return top, bot, mid
end

local function GetEntities()
    local now = tick()
    if now - entityCacheTime < ENTITY_TTL then return entityCache end
    entityCacheTime = now
    local list = {}
    local seenChars = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then
            local char = plr.Character
            if char then seenChars[char] = true end
            local status = GetWLStatus(plr)
            if status ~= "neutral" then
                if char then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    local hrp = char:FindFirstChild("HumanoidRootPart")
                    if hum and hum.Health > 0 and hrp then
                        local entry = {
                            char = char, hum = hum, hrp = hrp, player = plr,
                            isFriend = status == "friend", isPriority = GetWLPriority(plr)
                        }
                        if entry.isPriority then table.insert(list, 1, entry) else table.insert(list, entry) end
                    end
                end
            end
        end
    end
    for entity in pairs(espObjects) do
        if not seenChars[entity] then
            CleanupESP(entity)
        end
    end
    entityCache = list
    return list
end

local function SetHitbox(multiplier, char)
    local target = char or LP.Character
    if not target then return end
    local hrp = target:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local key = tostring(target)
    if multiplier <= 1 then
        if HitboxOriginals[key] then hrp.Size = HitboxOriginals[key] end
        return
    end
    if not HitboxOriginals[key] then HitboxOriginals[key] = hrp.Size end
    hrp.Size = HitboxOriginals[key] * multiplier
end

local function ResetAllHitboxes()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character then
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            local key = tostring(plr.Character)
            if hrp and HitboxOriginals[key] then hrp.Size = HitboxOriginals[key] end
        end
    end
    HitboxOriginals = {}
end

local function RecordTargetHistory(plr)
