Library:GiveSignal(RunService.RenderStepped:Connect(function(dt)
    if Library.Toggled or GlobalKillActive then
        HideAllESP() FOVCircle.Visible = false FOVFill.Visible = false HideHM()
        return
    end

    local vp = Camera.ViewportSize
    local center = Vector2.new(vp.X/2, vp.Y/2)

    if hitMarkerActive then
        hitMarkerTimer = hitMarkerTimer - dt DrawHM()
        if hitMarkerTimer <= 0 then hitMarkerActive = false HideHM() end
    end

    local aimbotOn = Toggles.AimbotEnabled and Toggles.AimbotEnabled.Value
    if aimbotOn then
        local fov = Options.AimbotFOV and Options.AimbotFOV.Value or 120
        local showFOV = Toggles.AimbotShowFOV and Toggles.AimbotShowFOV.Value or false
        FOVCircle.Visible = showFOV FOVCircle.Radius = fov FOVCircle.Position = center
        FOVFill.Visible = showFOV FOVFill.Radius = fov FOVFill.Position = center

        if Options.AimbotHitChance and math.random(1,100) <= Options.AimbotHitChance.Value then
            local target = GetAimTarget()
            if target then
                local partName = Options.AimbotTargetPart and Options.AimbotTargetPart.Value or "Head"
                local part = target:FindFirstChild(partName) or target:FindFirstChild("Head") or target:FindFirstChild("HumanoidRootPart")
                if part then
                    local useUUID = Toggles.AimbotUUIDLock and Toggles.AimbotUUIDLock.Value
                    if not useUUID then
                        local aimPos = part.Position
                        if Toggles.AimbotPrediction and Toggles.AimbotPrediction.Value then
                            local hrp = target:FindFirstChild("HumanoidRootPart")
                            if hrp then aimPos = aimPos + hrp.AssemblyLinearVelocity * (Options.AimbotPredOffset and Options.AimbotPredOffset.Value or 0.1) end
                        end
                        if Toggles.AimbotMicroJitter and Toggles.AimbotMicroJitter.Value then
                            local j = Options.AimbotJitterAmount and Options.AimbotJitterAmount.Value or 2
                            local cf = Camera.CFrame
                            aimPos = aimPos + cf.RightVector * (math.random(-j*10, j*10)/10) + cf.UpVector * (math.random(-j*10, j*10)/10)
                        end
                        if Toggles.AimbotUseSmoothing and Toggles.AimbotUseSmoothing.Value then
                            local s = Options.AimbotSmoothing and Options.AimbotSmoothing.Value or 8
                            Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, aimPos), math.min(dt*s, 1))
                        else
                            Camera.CFrame = CFrame.new(Camera.CFrame.Position, aimPos)
                        end
                    end
                    local hbSize = Options.AimbotHitboxSize and Options.AimbotHitboxSize.Value or 1
                    if hbSize > 1 then SetHitbox(hbSize, target) end
                end
            end
        end
    else
        FOVCircle.Visible = false FOVFill.Visible = false
    end

    if Toggles.TriggerbotEnabled and Toggles.TriggerbotEnabled.Value and not triggerFiring then
        local mouse = LP:GetMouse()
        local mt = mouse.Target
        if mt then
            local tc = Players:GetPlayerFromCharacter(mt.Parent)
            if tc and tc ~= LP then
                local skip = Toggles.AimbotTeamCheck and Toggles.AimbotTeamCheck.Value and SameTeam(LP, tc)
                local ws = GetWLStatus(tc)
                if ws ~= "friend" and ws ~= "neutral" and not skip then
                    local useVis = Toggles.TriggerbotVisCheck and Toggles.TriggerbotVisCheck.Value
                    local canFire = true
                    if useVis then canFire = CanSee(Camera.CFrame.Position, mt.Position, {LP.Character, tc.Character}) end
                    if canFire then
                        triggerFiring = true
                        local minD = Options.TriggerMin and Options.TriggerMin.Value or 50
                        local maxD = Options.TriggerMax and Options.TriggerMax.Value or 120
                        task.delay(math.random(minD, maxD)/1000, function()
                            if Toggles.TriggerbotEnabled and Toggles.TriggerbotEnabled.Value then
                                mouse1click()
                            end
                            triggerFiring = false
                        end)
                    end
                end
            end
        end
    end

    if Toggles.AimlockEnabled and Toggles.AimlockEnabled.Value then
        local lpChar = LP.Character
        local lpHRP = lpChar and lpChar:FindFirstChild("HumanoidRootPart")
        if lpHRP then
            local best = math.huge
            local bestTarget = nil
            for _, data in ipairs(GetEntities()) do
                if not data.isFriend then
                    local skip = Toggles.AimlockTeamCheck and Toggles.AimlockTeamCheck.Value and SameTeam(LP, data.player)
                    if not skip then
                        local head = data.char:FindFirstChild("Head")
                        if head then
                            local sp, on = Camera:WorldToViewportPoint(head.Position)
                            if on then
                                local sd = (Vector2.new(sp.X,sp.Y) - center).Magnitude
                                local fov = Options.AimlockFOV and Options.AimlockFOV.Value or 360
                                if sd <= fov and sd < best then
                                    local canHit = true
                                    if Toggles.AimlockVisCheck and Toggles.AimlockVisCheck.Value then
                                        canHit = CanSee(Camera.CFrame.Position, head.Position, {lpChar, data.char})
                                    end
                                    if canHit then best = sd bestTarget = head end
                                end
                            end
                        end
                    end
                end
            end
            if bestTarget then
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, bestTarget.Position)
            end
        end
    end

    espFrameSkip = espFrameSkip + 1
    if espFrameSkip < 3 then return end
    espFrameSkip = 0

    local espOn = Toggles.ESPEnabled and Toggles.ESPEnabled.Value
    local lpChar = LP.Character
    local lpHRP = lpChar and lpChar:FindFirstChild("HumanoidRootPart")
    local valid = {}
    local now = tick()

    for _, data in ipairs(GetEntities()) do
        local char = data.char
        local hum = data.hum
        local hrp = data.hrp
        local plr = data.player
        local isFriend = data.isFriend

        if char and char.Parent and hrp and hum and hum.Health > 0 and espOn then
            local maxDist = Options.ESPMaxDistance and Options.ESPMaxDistance.Value or 1000
            if not lpHRP or (lpHRP.Position - hrp.Position).Magnitude <= maxDist then
                local skipTeam = Toggles.ESPTeamCheck and Toggles.ESPTeamCheck.Value and plr and LP.Team ~= nil and plr.Team == LP.Team
                if not skipTeam then
                    local hrpSP, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                    if not espObjects[char] then MakeESP(char) end
                    local esp = espObjects[char]

                    local function hideAll()
                        local function h(k) if esp[k] and esp[k].__OBJECT_EXISTS then esp[k].Visible = false end end
                        h("Box") h("BoxFill") h("Tracer") h("NameText") h("DistText") h("HPBarBG") h("HPBar") h("HPText") h("TargetCircle") h("FriendTag")
                        HideCorner(esp)
                        for _, l in ipairs(esp.SkelLines) do if l.__OBJECT_EXISTS then l.Visible = false end end
                    end

                    if not onScreen then
                        hideAll()
                        if Toggles.ESPOffScreenArrows and Toggles.ESPOffScreenArrows.Value then
                            local col = isFriend and Color3.fromRGB(100,180,255) or SafeColor(Options.ESPBoxColor and Options.ESPBoxColor.Value)
                            DrawArrow(esp.ArrowLines, Vector2.new(math.clamp(hrpSP.X,40,vp.X-40), math.clamp(hrpSP.Y,40,vp.Y-40)), col)
                        else
                            for _, l in ipairs(esp.ArrowLines) do if l.__OBJECT_EXISTS then l.Visible = false end end
                        end
                    else
                        for _, l in ipairs(esp.ArrowLines) do if l.__OBJECT_EXISTS then l.Visible = false end end
                        local drawOk = true
                        if Toggles.ESPVisibleOnly and Toggles.ESPVisibleOnly.Value then
                            if (now - (visCacheTime[char] or 0)) >= VIS_TTL then
                                visCache[char] = CanSee(Camera.CFrame.Position, hrp.Position, {lpChar, char})
                                visCacheTime[char] = now
                            end
                            if not visCache[char] then drawOk = false end
                        end

                        if not drawOk then
                            hideAll()
                        else
                            valid[char] = true
                            local topWorld, botWorld, midWorld = GetModelBounds(char)
                            local topSP, topOn = Camera:WorldToViewportPoint(topWorld)
                            local botSP, botOn = Camera:WorldToViewportPoint(botWorld)
                            local midSP = Camera:WorldToViewportPoint(midWorld)

                            if not topOn or not botOn then
                                hideAll()
                            else
                                local boxH = math.abs(botSP.Y - topSP.Y)
                                local boxW = math.max(boxH/2.2, 20)
                                local boxX = midSP.X - boxW/2
                                local boxY = math.min(topSP.Y, botSP.Y)
                                local hpPct = math.clamp(hum.Health/hum.MaxHealth, 0, 1)
                                local col = isFriend and Color3.fromRGB(100,180,255) or SafeColor(Options.ESPBoxColor and Options.ESPBoxColor.Value)

                                if Toggles.ESPBoxFilled and Toggles.ESPBoxFilled.Value and esp.BoxFill.__OBJECT_EXISTS then
                                    esp.BoxFill.Visible = true esp.BoxFill.Size = Vector2.new(boxW,boxH) esp.BoxFill.Position = Vector2.new(boxX,boxY)
                                    esp.BoxFill.Color = col esp.BoxFill.Filled = true esp.BoxFill.Transparency = Options.ESPBoxFillAlpha and Options.ESPBoxFillAlpha.Value/100 or 0.06
                                else
                                    if esp.BoxFill.__OBJECT_EXISTS then esp.BoxFill.Visible = false end
                                end

                                local boxStyle = Options.ESPBoxStyle and Options.ESPBoxStyle.Value or "Corner"
                                if Toggles.ESPBox and Toggles.ESPBox.Value then
                                    if boxStyle == "Corner" then
                                        if esp.Box.__OBJECT_EXISTS then esp.Box.Visible = false end
                                        DrawCorner(esp, boxX, boxY, boxW, boxH, col, 1.2)
                                    else
                                        HideCorner(esp)
                                        if esp.Box.__OBJECT_EXISTS then
                                            esp.Box.Visible = true esp.Box.Size = Vector2.new(boxW,boxH) esp.Box.Position = Vector2.new(boxX,boxY)
                                            esp.Box.Color = col esp.Box.Thickness = 1.2 esp.Box.Filled = false esp.Box.Transparency = 1
                                        end
                                    end
                                else
                                    if esp.Box.__OBJECT_EXISTS then esp.Box.Visible = false end
                                    HideCorner(esp)
                                end

                                if Toggles.ESPTracer and Toggles.ESPTracer.Value and esp.Tracer.__OBJECT_EXISTS then
                                    local tracerCol = SafeColor(Options.ESPTracerColor and Options.ESPTracerColor.Value, col)
                                    local orig = Options.ESPTracerOrigin and Options.ESPTracerOrigin.Value
                                    local tracerFrom = (orig == "Bottom") and Vector2.new(vp.X/2, vp.Y) or center
                                    esp.Tracer.Visible = true esp.Tracer.From = tracerFrom esp.Tracer.To = Vector2.new(midSP.X, botSP.Y)
                                    esp.Tracer.Color = tracerCol esp.Tracer.Thickness = 0.8 esp.Tracer.Transparency = 0.7
                                else
                                    if esp.Tracer.__OBJECT_EXISTS then esp.Tracer.Visible = false end
                                end

                                local hpBarSide = Options.ESPHealthBarSide and Options.ESPHealthBarSide.Value or "Left"
                                local barThick = 3
                                local barX = hpBarSide == "Left" and (boxX - barThick - 3) or (boxX + boxW + 3)
                                local fillH = math.max(2, boxH * hpPct)
                                local fade = hpPct <= 0 and 0 or 1

                                if isFriend and esp.FriendTag.__OBJECT_EXISTS then
                                    esp.FriendTag.Visible = true esp.FriendTag.Text = "[FRIEND] " .. (plr and plr.Name or "?")
                                    esp.FriendTag.Position = Vector2.new(midSP.X, boxY-14) esp.FriendTag.Color = Color3.fromRGB(180,230,255)
                                    esp.FriendTag.Size = 12 esp.FriendTag.Center = true esp.FriendTag.Outline = true esp.FriendTag.Transparency = 1
                                    if esp.NameText.__OBJECT_EXISTS then esp.NameText.Visible = false end
                                elseif Toggles.ESPName and Toggles.ESPName.Value and esp.NameText.__OBJECT_EXISTS then
                                    esp.FriendTag.Visible = false
                                    local nameStr = plr and plr.Name or char.Name
                                    local distStr = ""
                                    if Toggles.ESPDistance and Toggles.ESPDistance.Value and lpHRP then
                                        local dist = math.floor((lpHRP.Position - hrp.Position).Magnitude)
                                        distStr = " · " .. dist .. "m"
                                    end
                                    esp.NameText.Visible = true esp.NameText.Text = nameStr .. distStr
                                    esp.NameText.Position = Vector2.new(midSP.X, boxY-13)
                                    esp.NameText.Color = Color3.fromRGB(255,255,255) esp.NameText.Size = 12 esp.NameText.Center = true esp.NameText.Outline = true esp.NameText.Transparency = 1
                                    if esp.DistText.__OBJECT_EXISTS then esp.DistText.Visible = false end
                                else
                                    if esp.NameText.__OBJECT_EXISTS then esp.NameText.Visible = false end
                                    if esp.FriendTag.__OBJECT_EXISTS then esp.FriendTag.Visible = false end
                                    if esp.DistText.__OBJECT_EXISTS then esp.DistText.Visible = false end
                                end

                                if Toggles.ESPHealthBar and Toggles.ESPHealthBar.Value then
                                    if esp.HPBarBG.__OBJECT_EXISTS then
                                        esp.HPBarBG.Visible = true esp.HPBarBG.Size = Vector2.new(barThick,boxH) esp.HPBarBG.Position = Vector2.new(barX,boxY)
                                        esp.HPBarBG.Color = Color3.fromRGB(15,15,15) esp.HPBarBG.Filled = true esp.HPBarBG.Transparency = 1
                                    end
                                    if esp.HPBar.__OBJECT_EXISTS then
                                        esp.HPBar.Visible = true esp.HPBar.Size = Vector2.new(barThick,fillH) esp.HPBar.Position = Vector2.new(barX,boxY+boxH-fillH)
                                        esp.HPBar.Color = HPColor(hpPct) esp.HPBar.Filled = true esp.HPBar.Transparency = fade
                                    end
                                    if Toggles.ESPHealthNumerical and Toggles.ESPHealthNumerical.Value and esp.HPText.__OBJECT_EXISTS then
                                        esp.HPText.Visible = true esp.HPText.Text = math.floor(hum.Health).."hp"
                                        esp.HPText.Position = Vector2.new(barX-1, boxY+boxH/2-5)
                                        esp.HPText.Color = Color3.fromRGB(255,255,255) esp.HPText.Size = 10 esp.HPText.Center = true esp.HPText.Outline = true esp.HPText.Transparency = 1
                                    else
                                        if esp.HPText.__OBJECT_EXISTS then esp.HPText.Visible = false end
                                    end
                                else
                                    if esp.HPBarBG.__OBJECT_EXISTS then esp.HPBarBG.Visible = false end
                                    if esp.HPBar.__OBJECT_EXISTS then esp.HPBar.Visible = false end
                                    if esp.HPText.__OBJECT_EXISTS then esp.HPText.Visible = false end
                                end

                                if Toggles.ESPSkeleton and Toggles.ESPSkeleton.Value then
                                    local joints = GetJoints(char)
                                    local uc = SafeColor(Options.ESPSkelUpperColor and Options.ESPSkelUpperColor.Value, Color3.fromRGB(220,220,220))
                                    local lc = SafeColor(Options.ESPSkelLowerColor and Options.ESPSkelLowerColor.Value, Color3.fromRGB(180,180,255))
                                    local count = math.min(#joints, #esp.SkelLines)
                                    for i = 1, count do
                                        local j = joints[i]
                                        local pA = char:FindFirstChild(j[1]) local pB = char:FindFirstChild(j[2]) local ln = esp.SkelLines[i]
                                        if pA and pB and ln.__OBJECT_EXISTS then
                                            local sA, onA = Camera:WorldToViewportPoint(pA.Position)
                                            local sB, onB = Camera:WorldToViewportPoint(pB.Position)
                                            if onA and onB then
                                                ln.Visible = true ln.From = Vector2.new(sA.X,sA.Y) ln.To = Vector2.new(sB.X,sB.Y)
                                                ln.Color = j[3]=="upper" and uc or lc ln.Thickness = 0.8 ln.Transparency = 0.85
                                            else ln.Visible = false end
                                        else
                                            if ln.__OBJECT_EXISTS then ln.Visible = false end
                                        end
                                    end
                                    for i = count+1, #esp.SkelLines do if esp.SkelLines[i].__OBJECT_EXISTS then esp.SkelLines[i].Visible = false end end
                                else
                                    for _, l in ipairs(esp.SkelLines) do if l.__OBJECT_EXISTS then l.Visible = false end end
                                end

                                local isLocked = aimLock == char
                                if Toggles.ESPTargetCircle and Toggles.ESPTargetCircle.Value and isLocked and esp.TargetCircle.__OBJECT_EXISTS then
                                    local head = char:FindFirstChild("Head") local headPos = head and head.Position or topWorld
                                    local hSP, hOn = Camera:WorldToViewportPoint(headPos)
                                    if hOn then
                                        esp.TargetCircle.Visible = true esp.TargetCircle.Position = Vector2.new(hSP.X,hSP.Y)
                                        esp.TargetCircle.Radius = Options.ESPTargetCircleRadius and Options.ESPTargetCircleRadius.Value or 14
                                        esp.TargetCircle.Color = Color3.fromRGB(255,200,0) esp.TargetCircle.Filled = false esp.TargetCircle.Thickness = 1.2 esp.TargetCircle.Transparency = 0.85 esp.TargetCircle.NumSides = 32
                                    else esp.TargetCircle.Visible = false end
                                else
                                    if esp.TargetCircle.__OBJECT_EXISTS then esp.TargetCircle.Visible = false end
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    for entity in pairs(espObjects) do
        if not valid[entity] then
            local hum = entity:FindFirstChildOfClass("Humanoid")
            if not entity.Parent or (hum and hum.Health <= 0) then
                CleanupESP(entity)
            end
        end
    end
end))

Library:GiveSignal(RunService.RenderStepped:Connect(function()
    local function hideRadar()
        radarBG.Visible=false radarBorder.Visible=false radarBGSq.Visible=false radarBorderSq.Visible=false
        radarCrossH.Visible=false radarCrossV.Visible=false radarSelfDot.Visible=false radarModeLabel.Visible=false
        for _, d in ipairs(radarDots) do d.Visible = false end
    end

    if Library.Toggled or not (Toggles.RadarEnabled and Toggles.RadarEnabled.Value) then hideRadar() return end

    radarFrameSkip = radarFrameSkip + 1
    if radarFrameSkip < 2 then return end
    radarFrameSkip = 0

    local shape = Options.RadarShape and Options.RadarShape.Value or "Circle"
    local opacity = Options.RadarOpacity and Options.RadarOpacity.Value or 50
    local range = Options.RadarRange and Options.RadarRange.Value or 0
    local show = Options.RadarShow and Options.RadarShow.Value or "Auto"
    RADAR_SIZE = Options.RadarSize and Options.RadarSize.Value or 180

    if radarDragging then
        local mp = UIS:GetMouseLocation()
        RADAR_X = mp.X - dragOffX
        RADAR_Y = mp.Y - dragOffY
    end

    local isFFA = not HasTeams()
    UpdateRadarGeometry(shape, opacity)

    local lpChar = LP.Character
    local lpHRP = lpChar and lpChar:FindFirstChild("HumanoidRootPart")
    local rcenter = GetRadarCenter()
    local rotAng = GetRadarRotAngle()
    DrawRadarSelfArrow(rcenter)

    local idx = 1
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and idx <= MAX_RADAR_DOTS then
            local char = plr.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 and lpHRP then
                local isTeam = LP.Team ~= nil and plr.Team ~= nil and plr.Team == LP.Team
                local skip = false
                if show == "Enemies Only" and isTeam then skip = true end
                if show == "Teammates Only" and not isTeam then skip = true end
                if not skip then
                    local sp, dist = WorldToRadar(hrp.Position, lpHRP, range, rotAng, shape)
                    local dot = radarDots[idx]
                    dot.Position = sp dot.Color = GetRadarDotColor(plr, dist, range, isFFA)
                    dot.Radius = 4 dot.Transparency = 1 dot.Visible = true
                    idx = idx + 1
                end
            end
        end
    end
    for i = idx, MAX_RADAR_DOTS do radarDots[i].Visible = false end
end))

UIS.InputBegan:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
    if not (Toggles.RadarEnabled and Toggles.RadarEnabled.Value) then return end
    local mp = UIS:GetMouseLocation()
    local rcenter = GetRadarCenter()
    local half = RADAR_SIZE / 2
    local shape = Options.RadarShape and Options.RadarShape.Value or "Circle"
    local hit = false
    if shape == "Circle" then hit = (mp - rcenter).Magnitude <= half
    else hit = mp.X >= RADAR_X and mp.X <= RADAR_X+RADAR_SIZE and mp.Y >= RADAR_Y and mp.Y <= RADAR_Y+RADAR_SIZE end
    if hit then radarDragging = true dragOffX = mp.X-RADAR_X dragOffY = mp.Y-RADAR_Y end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then radarDragging = false end
end)

